    <node id="Child Protective Services">
      <data key="d0">Child Protective Services</data>
      <data key="d1">organization</data>
      <data key="d2">Child Protective Services is a program defined in Oregon's regulation for the protection of children from abuse and neglect.&lt;SEP&gt;Child Protective Services, or CPS, is a program defined by regulatory guidelines aimed at protecting children from abuse and neglect.</data>
      <data key="d3">chunk-1b94684ed4ccca82345e4aa1b6f991ce&lt;SEP&gt;chunk-1e4225b326e03d893cc33c6027465e12</data>
      <data key="d4">unknown_source</data>
