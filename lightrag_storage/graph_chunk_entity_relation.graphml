    <node id="Outdoor Lighting">
      <data key="d0">Outdoor Lighting</data>
      <data key="d1">concept</data>
      <data key="d2">Outdoor Lighting refers to light fixtures installed outside buildings, regulated for height and light projection.&lt;SEP&gt;Outdoor lighting refers to lighting fixtures that must comply with height and light projection requirements.</data>
      <data key="d3">chunk-9f1f1b130f7e5afceced958bf6e3d52f&lt;SEP&gt;chunk-79f19e6435928fe4a325e8a1a4cc5dd1</data>
