    <node id="Inspections Manager">
      <data key="d0">Inspections Manager</data>
      <data key="d1">person</data>
      <data key="d2">The Inspections Manager oversees the Inspections Division of Portland Permitting &amp; Development.&lt;SEP&gt;The Inspections Manager supervises inspection activities and ensures compliance with regulations.</data>
      <data key="d3">chunk-a78f1876fb134d98c03a24e26b94fa88&lt;SEP&gt;chunk-44500823ae619d4a2c4e588251577618</data>
