    <node id="Native Shrubs">
      <data key="d0">Native Shrubs</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Native shrubs are recommended for planting in specified quantities to support habitat conversion.&lt;SEP&gt;Native Shrubs are shrub species required for replanting in the habitat conversion area, with specific quantities for compliance.&lt;SEP&gt;Native shrubs are plants being replanted in designated habitats to meet environmental standards in the Airport Subdistrict.</data>
      <data key="d3">chunk-539f4010f687efe24bc7e2b559aec360&lt;SEP&gt;chunk-f2dff9267506b3019f40d39ac0b51e11&lt;SEP&gt;chunk-0ced522134a19088883652798a704f52</data>
      <data key="d4">unknown_source</data>
