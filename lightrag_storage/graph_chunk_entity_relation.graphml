      <data key="d0">New Disturbance Area</data>
      <data key="d1">concept</data>
      <data key="d2">New Disturbance Area refers to areas where new environmental disturbances are prohibited within the Pleasant Valley Natural Resources Overlay Zone, with certain exceptions.</data>
      <data key="d3">chunk-88ff3afda2034b66968957b4926a887c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781108</data>
      <data key="d6" />
