    <node id="Overall Scheme">
      <data key="d0">Overall Scheme</data>
      <data key="d1">concept</data>
      <data key="d2">The Overall Scheme includes descriptions and plans that tie together the existing, proposed, and potential future developments within the PIR Master Plan.</data>
      <data key="d3">chunk-1cd2a226a2530256c685d499d90fe0b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781109</data>
      <data key="d6" />
    </node>
    <node id="Environmental Requirements">
      <data key="d0">Environmental Requirements</data>
      <data key="d1">concept</data>
      <data key="d2">The Environmental Requirements are regulations that must be satisfied during the review of the PIR Master Plan, ensuring compliance with environmental standards.</data>
      <data key="d3">chunk-1cd2a226a2530256c685d499d90fe0b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781109</data>
      <data key="d6" />
