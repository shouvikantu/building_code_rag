      <data key="d1">data</data>
      <data key="d2">The maximum height allowed for dwelling units within a cottage cluster is 25 feet.</data>
      <data key="d3">chunk-59644a82d0120b0f13d2a9d402862b9b</data>
      <data key="d4">unknown_source</data>
