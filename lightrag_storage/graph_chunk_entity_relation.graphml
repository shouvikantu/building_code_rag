      <data key="d0">DELC 21-2024</data>
      <data key="d1">concept</data>
      <data key="d2">DELC 21-2024 refers to a regulatory filing related to child care that includes a minor correction, effective from 04/11/2024.</data>
      <data key="d3">chunk-090946030f17ced3a228932753442ee3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Application Fee">
      <data key="d0">Application Fee</data>
      <data key="d1">concept</data>
      <data key="d2">The Application Fee consists of the costs associated with obtaining a child care center certificate, including initial certification, renewal, and capacity changes.</data>
      <data key="d3">chunk-090946030f17ced3a228932753442ee3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
