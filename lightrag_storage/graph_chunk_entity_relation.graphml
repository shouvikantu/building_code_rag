    <node id="Written Approval">
      <data key="d0">Written Approval</data>
      <data key="d1">concept</data>
      <data key="d2">Written approval is the necessary consent required from a public health administrator or licensed health care provider for a child to attend a certified child care center under specific health conditions.</data>
      <data key="d3">chunk-fb113bc290514e50db6d44d2d83ee490</data>
