      <data key="d1">concept</data>
      <data key="d2">Private Schools are independent educational institutions that provide state mandated education, distinct from public schools.</data>
      <data key="d3">chunk-92e255ad4213c8ff69b61a260e064f3c</data>
      <data key="d4">unknown_source</data>
