    <node id="R20 through R2.5 Zones">
      <data key="d0">R20 through R2.5 Zones</data>
      <data key="d1">concept</data>
      <data key="d2">R20 through R2.5 Zones are zoning classifications that allow for varying densities of residential housing types.</data>
      <data key="d3">chunk-f4254e6eb792730b58dedb0301cbb63d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768780999</data>
