    <node id="Campus Institutional 1">
      <data key="d0">Campus Institutional 1</data>
      <data key="d1">concept</data>
      <data key="d2">Campus Institutional 1 (CI1) is a zoning category intended for large colleges and medical centers near low and medium density residential neighborhoods.&lt;SEP&gt;Campus Institutional 1 (CI1) is a zoning designation for large colleges and medical centers in low to medium density residential areas with specific development standards.</data>
      <data key="d3">chunk-495d4288ccdffd88f955433753aaad68&lt;SEP&gt;chunk-22f515f37bfa2d9c859d1b9c66c32763</data>
