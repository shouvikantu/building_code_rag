    <node id="Pole Portion">
      <data key="d0">Pole Portion</data>
      <data key="d1">concept</data>
      <data key="d2">The pole portion pertains to a specific area of a flag lot, distinct from the flag portion, used in property calculations and regulations.</data>
      <data key="d3">chunk-5af8d828cbb38f1d71e4c9300bd4b4cc</data>
