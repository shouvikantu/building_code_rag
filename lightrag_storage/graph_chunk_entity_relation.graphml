      <data key="d0">Off-Street Paths</data>
      <data key="d1">concept</data>
      <data key="d2">Off-Street Paths are designated walkways that provide safe routes separate from vehicle traffic.</data>
      <data key="d3">chunk-bbc54ab4dbbc617d4c752a69733a5f32</data>
