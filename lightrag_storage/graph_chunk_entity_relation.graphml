    <node id="Parent">
      <data key="d0">Parent</data>
      <data key="d1">person</data>
      <data key="d2">A Parent is a guardian of a child who may be informed about the conditions of care provided at a child care facility, impacting their decisions regarding care.&lt;SEP&gt;A Parent is an individual with legal custody and physical care of a child, either a custodian or guardian.&lt;SEP&gt;Parent is defined as a child's parent, guardian, or any person 18 years or older with supervisory responsibility for the child.&lt;SEP&gt;A parent is a guardian or caretaker of a child who must be notified by the certified child care center regarding any issues or incidents affecting their child.&lt;SEP&gt;A parent is an individual who has children in a certified child care center and may have responsibilities or permissions related to transportation of children.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e&lt;SEP&gt;chunk-16982ad53929c50839970fc08b877b95&lt;SEP&gt;chunk-7087b54a804a29c105437eb0d2b68809&lt;SEP&gt;chunk-c4a7904f1485b792ad0d6843358b9f8d&lt;SEP&gt;chunk-0b42c9a94a5a6a4d816abf87a18c33c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781564</data>
      <data key="d6" />
    </node>
    <node id="Regular Operating Hours">
      <data key="d0">Regular Operating Hours</data>
      <data key="d1">concept</data>
      <data key="d2">Regular Operating Hours define the approved days and hours during which a child care facility may operate.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781439</data>
      <data key="d6" />
    </node>
    <node id="Recorded Program">
      <data key="d0">Recorded Program</data>
      <data key="d1">concept</data>
      <data key="d2">Recorded Program refers to a facility that has been issued a record by CCLD to operate a preschool or school-aged program.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781439</data>
      <data key="d6" />
    </node>
    <node id="Child Abuse and Neglect">
      <data key="d0">Child Abuse and Neglect</data>
      <data key="d1">concept</data>
      <data key="d2">Child Abuse and Neglect refers to the mistreatment of children, which must be reported as per regulations outlined by CCLD.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781439</data>
