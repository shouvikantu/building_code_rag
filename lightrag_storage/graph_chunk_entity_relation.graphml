    <node id="Drainage Districts">
      <data key="d0">Drainage Districts</data>
      <data key="d1">organization</data>
      <data key="d2">Drainage Districts are governmental bodies responsible for managing control structures and conveyance channels as defined in ORS 547.</data>
      <data key="d3">chunk-899c4b9a2ac9d3d9713b5cef39a863b0</data>
