    <node id="Central Eastside Subdistrict">
      <data key="d0">Central Eastside Subdistrict</data>
      <data key="d1">location</data>
      <data key="d2">The Central Eastside Subdistrict is an area designated for various employment uses aimed at enhancing economic vitality while supporting industrial functions.</data>
      <data key="d3">chunk-d08b01451771b358c77494f198e0c0a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781123</data>
