      <data key="d0">Table 266-2</data>
      <data key="d1">content</data>
      <data key="d2">Table 266-2 details the maximum allowed parking spaces by use, determining parking requirements for various categories.&lt;SEP&gt;Table 266-2 outlines the maximum allowed parking ratios for various uses in the Hollywood Plan District.</data>
      <data key="d3">chunk-f8966d01e665f9cb17191db9bb5912d2&lt;SEP&gt;chunk-3b34f0df60116c5736f2d7981efaa2b3</data>
