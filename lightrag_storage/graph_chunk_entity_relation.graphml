    <node id="Residential Demolition Delay Regulations">
      <data key="d0">Residential Demolition Delay Regulations</data>
      <data key="d1">concept</data>
      <data key="d2">The Residential Demolition Delay Regulations are intended to provide time to save viable housing before allowing demolition, with a notice period.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
