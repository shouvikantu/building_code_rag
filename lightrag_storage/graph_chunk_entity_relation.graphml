    <node id="Minimum Lot Area Standard">
      <data key="d0">Minimum Lot Area Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The minimum lot area standard defines the least amount of land required for a lot to be considered compliant with zoning regulations.</data>
      <data key="d3">chunk-fb1ab98a275a3e96b292afb310b8237d</data>
