    </node>
    <node id="Portland Fire &amp; Rescue">
      <data key="d0">Portland Fire &amp; Rescue</data>
      <data key="d1">organization</data>
      <data key="d2">Portland Fire &amp; Rescue is the fire department responsible for fire safety and management in the City of Portland.</data>
      <data key="d3">chunk-43230c8c64a3e12675c36b28cd80b9f7&lt;SEP&gt;chunk-0d1029e4cbf53e8d0067df848d061a4f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779848</data>
