    <node id="Tree Preservation Standards">
      <data key="d0">Tree Preservation Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Tree Preservation Standards refer to regulations outlined in Section 33.630.100 governing the preservation of trees during land development.</data>
      <data key="d3">chunk-00a7652f0b0b380d8dc6c5c8262a6ea8</data>
      <data key="d4">unknown_source</data>
