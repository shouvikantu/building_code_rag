    </edge>
    <edge source="Radio Frequency Transmission Facilities" target="L3 Standard">
      <data key="d7">1.0</data>
      <data key="d8">Radio Frequency Transmission Facilities must conform to the L3 Standard for screening from public areas.</data>
      <data key="d9">compliance standard,screening requirement</data>
