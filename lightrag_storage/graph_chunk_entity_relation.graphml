    <node id="Category One">
      <data key="d0">Category One</data>
      <data key="d1">category</data>
      <data key="d2">Category One consists of agricultural producers, including at least 50% of vendors at farmers markets who sell directly grown or produced goods.&lt;SEP&gt;Category One refers to the category of market vendors that are primarily engaged in agriculture or food-related activities.</data>
