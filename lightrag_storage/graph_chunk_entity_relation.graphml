    <node id="Keeper of the National Register of Historic Places">
      <data key="d0">Keeper of the National Register of Historic Places</data>
      <data key="d1">organization</data>
      <data key="d2">The Keeper of the National Register of Historic Places is the federal authority that oversees the listing and delisting of historic landmarks on the national register.&lt;SEP&gt;The Keeper of the National Register of Historic Places is a federal authority overseeing the listing of Historic resources.</data>
      <data key="d3">chunk-516f4309419d52a2c0f6920e39b0dbdb&lt;SEP&gt;chunk-33f6d86139e9f8ebbadc462769659fed</data>
      <data key="d4">unknown_source</data>
