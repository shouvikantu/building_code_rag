      <data key="d0">Radio Frequency Transmission Facility</data>
      <data key="d1">concept</data>
      <data key="d2">Radio Frequency Transmission Facility includes any structures or equipment designed for transmitting radio frequencies, subject to height, distance, and power regulations.</data>
      <data key="d3">chunk-ace73fe9057e3e9a8fa2fac920590272</data>
      <data key="d4">unknown_source</data>
