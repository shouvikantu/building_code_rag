    </node>
    <node id="Architectural Heritage Center/Bosco-Milligan Foundation, Inc.">
      <data key="d0">Architectural Heritage Center/Bosco-Milligan Foundation, Inc.</data>
      <data key="d1">organization</data>
      <data key="d2">The Architectural Heritage Center/Bosco-Milligan Foundation, Inc. is an organization mentioned in the context of notifications related to demolition permits.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
