    <node id="License-Exempt Child Care">
      <data key="d0">License-Exempt Child Care</data>
      <data key="d1">concept</data>
      <data key="d2">License-Exempt Child Care refers to child care that is not mandated to be licensed under specific conditions stated in the rules.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781439</data>
      <data key="d6" />
