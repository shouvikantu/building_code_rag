    <node id="Campus Institutional 2">
      <data key="d0">Campus Institutional 2</data>
      <data key="d1">concept</data>
      <data key="d2">Campus Institutional 2 (CI2) is a zoning category designated for large medical centers, colleges, and universities near regional centers or along civic corridors.&lt;SEP&gt;Campus Institutional 2 (CI2) is a zoning designation that encourages urban scale development and has different standards than CI1.</data>
      <data key="d3">chunk-495d4288ccdffd88f955433753aaad68&lt;SEP&gt;chunk-22f515f37bfa2d9c859d1b9c66c32763</data>
      <data key="d4">unknown_source</data>
