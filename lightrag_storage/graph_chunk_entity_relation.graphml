    <node id="Vibration Standards">
      <data key="d0">Vibration Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Vibration Standards regulate allowable vibration levels to protect individuals with normal sensitivities from feeling excessive vibrations.</data>
      <data key="d3">chunk-d771f61eac49b01fc5796204c75025ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781090</data>
