      <data key="d6" />
    </node>
    <node id="Dead-End Streets">
      <data key="d0">Dead-End Streets</data>
      <data key="d1">concept</data>
      <data key="d2">Dead-End Streets are streets that terminate without allowing further passage and have specific regulations regarding their length and number of lots served.</data>
      <data key="d3">chunk-7014f2d99071dd5f926719c5b91b21ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781061</data>
