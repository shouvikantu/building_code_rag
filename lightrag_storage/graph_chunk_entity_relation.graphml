    <node id="Oregon Tribes">
      <data key="d0">Oregon Tribes</data>
      <data key="d1">organization</data>
      <data key="d2">Oregon Tribes refers to the various Native American tribes located within the state of Oregon that must be consulted for archaeological evaluations.&lt;SEP&gt;Oregon tribes are groups recognized as having historical and cultural ties to the state of Oregon, involved in consultations regarding archaeological findings.&lt;SEP&gt;Oregon tribes are recognized tribal groups that may be consulted regarding archaeological resources during development projects.</data>
      <data key="d3">chunk-df192280c989d3e1d2bc59bf520124ed&lt;SEP&gt;chunk-7da06ccf2e9fcb917a0a33d7f94dc73f&lt;SEP&gt;chunk-26cd939550cd7265fc4c8d659c5ff9f9</data>
