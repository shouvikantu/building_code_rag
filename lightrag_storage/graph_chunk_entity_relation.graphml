      <data key="d0">Coliform Bacteria</data>
      <data key="d1">concept</data>
      <data key="d2">Coliform bacteria are microorganisms tested for in water supplies at child care centers to confirm safety standards.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
