    <node id="New Construction">
      <data key="d0">New Construction</data>
      <data key="d1">concept</data>
      <data key="d2">New Construction refers to structures where construction began on or after October 18, 1979.&lt;SEP&gt;New construction refers to structures for which construction commenced on or after October 18, 1979.</data>
      <data key="d3">chunk-0822aa249af1cada3cc5aa958e97dce7&lt;SEP&gt;chunk-1db63c93213cb06b155d2b22811e90c9</data>
