    <node id="Table 130-1">
      <data key="d0">Table 130-1</data>
      <data key="d1">data</data>
      <data key="d2">Table 130-1 lists the allowed and limited uses in commercial/mixed use zones denoting if they comply with specific regulations.&lt;SEP&gt;Table 130-1 lists the primary uses and categories applicable to the CM3 and CE zones, specifying which uses are permitted or prohibited.&lt;SEP&gt;Table 130-1 outlines regulations and limitations regarding various land use categories, including industrial and community service uses.</data>
      <data key="d3">chunk-fab78bf22476f90e50de5d511279727d&lt;SEP&gt;chunk-8aafe5a7a2907664ceccb93037cc2fb8&lt;SEP&gt;chunk-58ceb0639cc3b4b602e0b2c747a13e8e</data>
      <data key="d4">unknown_source</data>
