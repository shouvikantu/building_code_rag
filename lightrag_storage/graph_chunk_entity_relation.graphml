      <data key="d1">concept</data>
      <data key="d2">Behavior and Guidance outlines the practices and measures that child care providers should follow for disciplining and guiding children's behavior.</data>
      <data key="d3">chunk-e4ccb0f82480e6741e25e253a6be980a</data>
      <data key="d4">unknown_source</data>
