    <node id="Subdistricts B and C">
      <data key="d0">Subdistricts B and C</data>
      <data key="d1">location</data>
      <data key="d2">Subdistricts B and C are designated areas where specific nonresidential use regulations apply.</data>
      <data key="d3">chunk-861d2a39c6243daf2d9eb704cb764a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781079</data>
      <data key="d6" />
