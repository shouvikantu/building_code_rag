      <data key="d0">Pleasant Valley Natural Resource Overlay Zone</data>
      <data key="d1">concept</data>
      <data key="d2">The Pleasant Valley Natural Resource overlay zone is a designated area that restricts outdoor shelters to protect natural resources.</data>
      <data key="d3">chunk-8d094258a7672d9b9a828426b17e2146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781089</data>
      <data key="d6" />
    </node>
    <node id="River Natural Overlay Zones">
      <data key="d0">River Natural Overlay Zones</data>
      <data key="d1">concept</data>
      <data key="d2">River natural overlay zones are protected areas adjacent to rivers where outdoor shelters are prohibited.</data>
      <data key="d3">chunk-8d094258a7672d9b9a828426b17e2146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781089</data>
      <data key="d6" />
    </node>
    <node id="River Environmental Overlay Zones">
      <data key="d0">River Environmental Overlay Zones</data>
      <data key="d1">concept</data>
      <data key="d2">River environmental overlay zones are areas that restrict development, including outdoor shelters, to safeguard the river environment.</data>
      <data key="d3">chunk-8d094258a7672d9b9a828426b17e2146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781089</data>
      <data key="d6" />
    </node>
    <node id="Scenic Overlay Zones">
      <data key="d0">Scenic Overlay Zones</data>
      <data key="d1">concept</data>
      <data key="d2">Scenic overlay zones are regions where outdoor shelters are restricted to maintain visual aesthetics.</data>
      <data key="d3">chunk-8d094258a7672d9b9a828426b17e2146</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781089</data>
      <data key="d6" />
    </node>
    <node id="Section 33.285">
      <data key="d0">Section 33.285</data>
      <data key="d1">concept</data>
      <data key="d2">Section 33.285 refers to a regulatory section related to planning and zoning specifically addressing short term, mass, and outdoor shelters.</data>
