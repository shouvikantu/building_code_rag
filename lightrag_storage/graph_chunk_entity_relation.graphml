    </node>
    <node id="Board">
      <data key="d0">Board</data>
      <data key="d1">organization</data>
      <data key="d2">The Board is a governing body that will either affirm or modify the Chief's decisions based on specific criteria.</data>
      <data key="d3">chunk-7e8c1c7b39585a7a7e3106344983f67e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
