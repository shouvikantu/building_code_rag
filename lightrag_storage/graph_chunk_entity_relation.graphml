    <node id="Access Easement">
      <data key="d0">Access Easement</data>
      <data key="d1">concept</data>
      <data key="d2">An Access Easement is a legal right granted to allow entry and maintenance for utilities or other structures that cross real property lines.</data>
      <data key="d3">chunk-616337655b3a110b38e3cef90183ec87</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
      <data key="d6" />
