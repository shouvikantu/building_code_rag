    <node id="Noncontributing Resource">
      <data key="d0">Noncontributing Resource</data>
      <data key="d1">concept</data>
      <data key="d2">A Noncontributing Resource is a resource that does not contribute to the historic significance of a Conservation District and can be reclassified during the designation process.</data>
      <data key="d3">chunk-d7bc900b38790ffcdef889113926820f</data>
      <data key="d4">unknown_source</data>
