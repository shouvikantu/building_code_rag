    <node id="Montgomery Park Area Plan">
      <data key="d0">Montgomery Park Area Plan</data>
      <data key="d1">plan</data>
      <data key="d2">The Montgomery Park Area Plan includes public benefits agreements related to the development of middle-wage jobs in the area, impacting nonresidential use regulations.&lt;SEP&gt;The Montgomery Park Area Plan outlines public benefits agreements for parks and open spaces in development contexts.</data>
      <data key="d3">chunk-05299df3decd7e8061aff48bb1ba2029&lt;SEP&gt;chunk-a5ce54762dd350a2baa6b3563a59fff3</data>
