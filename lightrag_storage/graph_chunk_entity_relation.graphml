    <node id="Required Pedestrian Connections">
      <data key="d0">Required Pedestrian Connections</data>
      <data key="d1">concept</data>
      <data key="d2">Required Pedestrian Connections are pathways that contribute to the overall design and accessibility of common outdoor areas.</data>
