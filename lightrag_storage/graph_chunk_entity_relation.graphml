    <node id="BDS">
      <data key="d0">BDS</data>
      <data key="d1">organization</data>
      <data key="d2">BDS refers to the Bureau of Development Services, which requires compliance reports from qualified archaeologists for resource recovery plans.</data>
      <data key="d3">chunk-903c333e61f6db5523241ff9b270a90f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781124</data>
