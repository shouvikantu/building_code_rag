    <node id="Arborist">
      <data key="d0">Arborist</data>
      <data key="d1">person</data>
      <data key="d2">An arborist is a professional who determines the condition of trees and advises on their management and removal.&lt;SEP&gt;An arborist is a professional who assesses the health and safety of trees, determining their condition for removal or preservation.&lt;SEP&gt;An Arborist is a professional certified or registered in tree care and management.</data>
      <data key="d3">chunk-4ca2fc1b73b6e1ae4e82cbaf205ce719&lt;SEP&gt;chunk-3aa149f451b6af62929512ddc6383e53&lt;SEP&gt;chunk-68c858bb23efe67cb70612c0464f3e80</data>
