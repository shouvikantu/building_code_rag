      <data key="d6" />
    </node>
    <node id="Native Plants">
      <data key="d0">Native Plants</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Native Plants include a variety of vegetation, which must be planted in designated quantities for habitat compliance.&lt;SEP&gt;Native plants include a variety of flora that is essential for habitat restoration and conservation efforts in the area.</data>
      <data key="d3">chunk-539f4010f687efe24bc7e2b559aec360&lt;SEP&gt;chunk-f2dff9267506b3019f40d39ac0b51e11</data>
