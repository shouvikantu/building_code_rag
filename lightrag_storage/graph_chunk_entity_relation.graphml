    <node id="Loose-Fill Materials">
      <data key="d0">Loose-Fill Materials</data>
      <data key="d1">concept</data>
      <data key="d2">Loose-fill materials are materials used in play areas that must meet specific depth requirements to ensure safety.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Climbing Equipment">
      <data key="d0">Climbing Equipment</data>
      <data key="d1">equipment</data>
      <data key="d2">Climbing equipment refers to non-portable play structures that must be securely anchored in accordance with manufacturer's instructions.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Outdoor Play Areas">
      <data key="d0">Outdoor Play Areas</data>
      <data key="d1">location</data>
      <data key="d2">Outdoor play areas are designated spaces for children’s play that must include shaded areas to protect against sun exposure.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Trampolines">
      <data key="d0">Trampolines</data>
      <data key="d1">equipment</data>
      <data key="d2">Trampolines, excluding rebounders, are prohibited in child care settings, while rebounders have specific usage restrictions.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Inflatable Equipment">
      <data key="d0">Inflatable Equipment</data>
      <data key="d1">equipment</data>
      <data key="d2">Inflatable equipment such as bounce houses and moon walkers is allowed if used according to manufacturer instructions and with staff supervision.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Gross Motor Equipment">
      <data key="d0">Gross Motor Equipment</data>
      <data key="d1">concept</data>
      <data key="d2">Gross motor equipment includes various play items designed to develop physical skills like climbing, balancing, and pedaling.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Helmet">
      <data key="d0">Helmet</data>
      <data key="d1">equipment</data>
      <data key="d2">A helmet is a safety device that must be worn by children using wheeled rides like bicycles and scooters, ensuring protection during use.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Handwashing">
      <data key="d0">Handwashing</data>
      <data key="d1">method</data>
      <data key="d2">Handwashing is a crucial hygiene practice for staff and children in child care settings, required after specific activities to prevent illness spread.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Hand Sanitizer">
      <data key="d0">Hand Sanitizer</data>
      <data key="d1">product</data>
      <data key="d2">Hand sanitizer is an alternative to handwashing, requiring supervision for use among young children, especially those under 24 months.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Temperature Measurement">
      <data key="d0">Temperature Measurement</data>
      <data key="d1">method</data>
      <data key="d2">Temperature measurement refers to the process of checking a child's temperature to monitor for illness, ensuring safe practices are followed.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Mercury Thermometers">
      <data key="d0">Mercury Thermometers</data>
      <data key="d1">product</data>
      <data key="d2">Mercury thermometers are prohibited for use in child care settings due to safety concerns.</data>
      <data key="d3">chunk-d7b088891170652a6ae3540112924504</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="Training Cup">
      <data key="d0">Training Cup</data>
      <data key="d1">artifact</data>
      <data key="d2">A training cup is a drinking vessel designed for infants transitioning from bottles to cups.</data>
      <data key="d3">chunk-413de6970c782ab39f7b5ab84bc167b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
