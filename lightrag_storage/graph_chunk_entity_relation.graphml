    <node id="Height Restrictions">
      <data key="d0">Height Restrictions</data>
      <data key="d1">concept</data>
      <data key="d2">Height Restrictions pertain to regulations that limit the height of structures and vegetation to protect views and manage environmental impacts.</data>
