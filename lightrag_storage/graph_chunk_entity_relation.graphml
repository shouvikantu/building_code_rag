    <node id="Standard 1">
      <data key="d0">Standard 1</data>
      <data key="d1">concept</data>
      <data key="d2">Standard 1 is a regulatory guideline requiring at least 50 percent of the ground-level street-facing facade to be within the maximum setback.</data>
      <data key="d3">chunk-c05d0565960f8c21b2582374b4856a38</data>
      <data key="d4">unknown_source</data>
