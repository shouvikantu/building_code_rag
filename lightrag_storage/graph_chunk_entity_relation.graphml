    <node id="Conditions of Land Use Approvals">
      <data key="d0">Conditions of Land Use Approvals</data>
      <data key="d1">concept</data>
      <data key="d2">Conditions of Land Use Approvals refer to specific requirements or restrictions laid out during the approval of land use applications, guiding compliance with regulations.</data>
      <data key="d3">chunk-5a98088aa848c3a646425801c36c9f6b</data>
