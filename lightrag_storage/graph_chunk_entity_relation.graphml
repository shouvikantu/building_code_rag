    <node id="Growing Medium">
      <data key="d0">Growing Medium</data>
      <data key="d1">concept</data>
      <data key="d2">Growing medium is a prepared mix of substances used to support plant growth, which may include soil, compost, sand, and other materials.&lt;SEP&gt;Growing medium refers to the soil amendments required for planting in specified conditions.</data>
      <data key="d3">chunk-148b4481af37fbad429e170e0527ee60&lt;SEP&gt;chunk-4bc3fc3ad91ea490a2f8ffb98e83e2ba</data>
      <data key="d4">unknown_source</data>
