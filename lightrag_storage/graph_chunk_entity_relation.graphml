    <node id="Lead-Based Paint Inspection Report">
      <data key="d0">Lead-Based Paint Inspection Report</data>
      <data key="d1">document</data>
      <data key="d2">A Lead-Based Paint Inspection Report is needed to seek an exemption from lead-hazard reduction requirements.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
