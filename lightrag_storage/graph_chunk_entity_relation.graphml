    <node id="Tower Sharing">
      <data key="d0">Tower Sharing</data>
      <data key="d1">concept</data>
      <data key="d2">Tower Sharing refers to the practice of using existing towers or structures for new wireless services to avoid the construction of additional towers.</data>
