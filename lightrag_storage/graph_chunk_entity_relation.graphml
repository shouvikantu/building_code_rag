    <node id="Bureau of Transportation Engineering">
      <data key="d0">Bureau of Transportation Engineering</data>
      <data key="d1">organization</data>
      <data key="d2">The Bureau of Transportation Engineering oversees public street and sidewalk standards within urban planning frameworks.&lt;SEP&gt;The Bureau of Transportation Engineering sets minimum width standards for streets and sidewalks in public right-of-ways.</data>
      <data key="d3">chunk-899c4b9a2ac9d3d9713b5cef39a863b0&lt;SEP&gt;chunk-70d37b0db2824c732a3a9a02ff910d85</data>
