    <node id="Subsection G">
      <data key="d0">Subsection G</data>
      <data key="d1">concept</data>
      <data key="d2">Subsection G contains criteria that are applied in the evaluation of Historic landmarks within the guidelines of the document.&lt;SEP&gt;Subsection G refers to specific criteria used for evaluating Historic Landmarks during historic resource reviews.&lt;SEP&gt;Subsection G contains specific criteria for evaluating Historic Landmarks, particularly when conflicts arise with design guidelines.</data>
      <data key="d3">chunk-3c00423593f4ba14979614a9190e4c49&lt;SEP&gt;chunk-e81cd4184be21ff7c937e2bc32ad5b35&lt;SEP&gt;chunk-5a6a80015da77a2175c0409b020ea13e</data>
