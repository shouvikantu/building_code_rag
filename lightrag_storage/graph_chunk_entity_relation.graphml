    <node id="RX">
      <data key="d0">RX</data>
      <data key="d1">concept</data>
      <data key="d2">RX represents zoning for areas designated for mixed-use, often incorporating retail and residential elements.&lt;SEP&gt;RX is a zoning designation for mixed-use and residential development in urban planning.&lt;SEP&gt;RX is a zoning designation applicable to projects in relation to bonus floor area options.</data>
      <data key="d3">chunk-bb053937b4fd6958f885edbd491a92e1&lt;SEP&gt;chunk-d93214ee5c49fbb5384175df60c9eafe&lt;SEP&gt;chunk-54d3c1a461749c2773607b44c831a1a7</data>
      <data key="d4">unknown_source</data>
