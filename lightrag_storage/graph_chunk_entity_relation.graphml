      <data key="d0">Chapter 33.630 Title 33</data>
      <data key="d1">concept</data>
      <data key="d2">Chapter 33.630 Title 33 outlines planning and zoning regulations related to tree preservation and flood hazard areas.</data>
      <data key="d3">chunk-cd8537f80e77714b5b0188914023a593</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781104</data>
