    <node id="Minimum Front Lot Line Standard">
      <data key="d0">Minimum Front Lot Line Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The minimum front lot line standard sets the least distance allowed for the front boundary of a lot adjacent to a street.</data>
