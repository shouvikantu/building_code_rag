      <data key="d1">legal_code</data>
      <data key="d2">Oregon Revised Statutes 468A.757 pertains to asbestos-related regulations and is referenced in the context of asbestos surveys.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
