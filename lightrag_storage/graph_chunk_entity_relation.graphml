    <node id="Institutional Office Uses">
      <data key="d0">Institutional Office Uses</data>
      <data key="d1">concept</data>
      <data key="d2">Institutional office uses refer to office spaces related to the mission of an institution, including accessory and primary uses defined in the impact mitigation plan.</data>
      <data key="d3">chunk-aaed07dc46c4dea3061745b8e0750d03</data>
      <data key="d4">unknown_source</data>
