      <data key="d1">concept</data>
      <data key="d2">Noise Sensitive Uses include dwellings, religious institutions, schools, and hospitals that require additional protections from noise.</data>
      <data key="d3">chunk-d771f61eac49b01fc5796204c75025ef</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781090</data>
