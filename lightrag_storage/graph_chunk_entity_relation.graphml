      <data key="d5">1768781057</data>
      <data key="d6" />
    </node>
    <node id="Halprin Open Space Sequence Historic District">
      <data key="d0">Halprin Open Space Sequence Historic District</data>
      <data key="d1">location</data>
      <data key="d2">The Halprin Open Space Sequence Historic District is a protected area that influences signage regulations within its vicinity.&lt;SEP&gt;The Halprin Open Space Sequence Historic District is a designated area with specific regulations for signage and sign face area.</data>
      <data key="d3">chunk-9f1f1b130f7e5afceced958bf6e3d52f&lt;SEP&gt;chunk-79f19e6435928fe4a325e8a1a4cc5dd1</data>
