    <node id="Demolition Manager">
      <data key="d0">Demolition Manager</data>
      <data key="d1">person</data>
      <data key="d2">The Demolition Manager is responsible for the oversight and implementation of the demolition plan for a property.&lt;SEP&gt;The Demolition Manager is the designated person responsible for overseeing and implementing the demolition plan and serves as the contact for regulatory agencies.&lt;SEP&gt;The Demolition Manager is the individual responsible for managing demolition activities and must be contacted as per the notice requirements.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de&lt;SEP&gt;chunk-7e8c1c7b39585a7a7e3106344983f67e&lt;SEP&gt;chunk-d2eaaf54ea337fd1c606b95b01bf732d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
    </node>
    <node id="Demolition Plan">
      <data key="d0">Demolition Plan</data>
      <data key="d1">document</data>
      <data key="d2">The Demolition Plan outlines the techniques and equipment used during demolition activities to ensure compliance with dust suppression regulations.&lt;SEP&gt;The Demolition Plan outlines the required procedures, site control measures, and safety protocols for demolition activities.&lt;SEP&gt;A Demolition Plan details the procedures and requirements necessary for the demolition of a structure.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de&lt;SEP&gt;chunk-930e46297d467ccce29bccc576758110&lt;SEP&gt;chunk-60990f5dab82c2b537b14b43e0a453ca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
    </node>
    <node id="Mechanical Demolition Activities">
      <data key="d0">Mechanical Demolition Activities</data>
      <data key="d1">concept</data>
      <data key="d2">Mechanical Demolition Activities involve using mechanical tools such as cranes and bulldozers to pull down structures and load demolition materials.&lt;SEP&gt;Mechanical Demolition Activities refer to the physical processes involved in the demolition of structures, requiring specific safety and environmental protocols.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de&lt;SEP&gt;chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
    </node>
    <node id="Lead-Based Paint">
      <data key="d0">Lead-Based Paint</data>
      <data key="d1">concept</data>
      <data key="d2">Lead-Based Paint is any paint that contains lead above defined safety thresholds, posing potential health risks.&lt;SEP&gt;Lead-based paint is a hazardous material that must be tested and remediated if found in buildings or play structures constructed before 1978.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de&lt;SEP&gt;chunk-3bc8af7a631ba667698fda678ebafaca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781570</data>
      <data key="d6" />
    </node>
    <node id="Responsible Party">
      <data key="d0">Responsible Party</data>
      <data key="d1">concept</data>
      <data key="d2">The Responsible Party refers to the property owner or authorized person accountable for regulatory compliance and actions related to demolition.</data>
      <data key="d3">chunk-a4e4166aaef8e1cf6d96fa7a807af0de</data>
      <data key="d4">unknown_source</data>
