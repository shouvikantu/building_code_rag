      <data key="d1">concept</data>
      <data key="d2">Chapter 24.10 Administration and Enforcement describes the administration and enforcement of the Title 24 Building Regulations.</data>
      <data key="d3">chunk-4f1c1a120b8ba477f5a407d0777a44e3</data>
      <data key="d4">unknown_source</data>
