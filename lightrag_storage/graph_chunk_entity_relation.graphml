    <node id="Replacement Trees">
      <data key="d0">Replacement Trees</data>
      <data key="d1">category</data>
      <data key="d2">Replacement Trees are native trees required to be planted to compensate for the removal of trees and ensure ecological balance.&lt;SEP&gt;Replacement trees refer to the trees that must be planted as a penalty for violations regarding tree removals.</data>
      <data key="d3">chunk-3059e173ef884a58e8cd223998e6158d&lt;SEP&gt;chunk-13c24553d0786fad8dd03e98ef27205d</data>
