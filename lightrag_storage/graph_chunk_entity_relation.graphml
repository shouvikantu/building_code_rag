    <node id="F1 Fence Standard">
      <data key="d0">F1 Fence Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The F1 Fence Standard offers a tall, partially sight-obscuring visual separation where visibility between areas is important.</data>
      <data key="d3">chunk-54018cb95b587cdb265182d453408b50</data>
      <data key="d4">unknown_source</data>
