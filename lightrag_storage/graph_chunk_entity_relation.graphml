    <node id="Willamette Greenway">
      <data key="d0">Willamette Greenway</data>
      <data key="d1">concept</data>
      <data key="d2">The Willamette Greenway comprises designated areas along the Willamette River, outlining land use and development regulations.</data>
      <data key="d3">chunk-0faba42bb95011a11cda5b0c9113041e</data>
