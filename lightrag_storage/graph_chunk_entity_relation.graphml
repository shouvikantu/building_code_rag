    <node id="Transitional Housing Accommodations">
      <data key="d0">Transitional Housing Accommodations</data>
      <data key="d1">concept</data>
      <data key="d2">Transitional Housing Accommodations refer to temporary housing solutions defined by House Bill 2916 in Oregon.</data>
      <data key="d3">chunk-616337655b3a110b38e3cef90183ec87</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
      <data key="d6" />
    </node>
    <node id="Flood Control Structures">
      <data key="d0">Flood Control Structures</data>
      <data key="d1">concept</data>
      <data key="d2">Flood Control Structures include structures such as dams and levees designed to manage and control flood risks.</data>
      <data key="d3">chunk-616337655b3a110b38e3cef90183ec87</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
      <data key="d6" />
    </node>
    <node id="Chief">
      <data key="d0">Chief</data>
      <data key="d1">person</data>
      <data key="d2">The Chief is responsible for making modifications to hazard values and overseeing the application of the Wildfire Hazard Zone in the City.&lt;SEP&gt;The Chief is an authoritative figure responsible for making decisions that are subject to review by the Board.</data>
      <data key="d3">chunk-7e8c1c7b39585a7a7e3106344983f67e&lt;SEP&gt;chunk-e74fbd35235f431d27b1fedb2323fc8b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
