      <data key="d0">Table 285-1</data>
      <data key="d1">data</data>
      <data key="d2">Table 285-1 outlines the maximum number of shelter beds allowed within mass shelters based on zoning classifications.</data>
      <data key="d3">chunk-8d094258a7672d9b9a828426b17e2146</data>
