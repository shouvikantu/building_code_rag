    <node id="Code Hearings Officer">
      <data key="d0">Code Hearings Officer</data>
      <data key="d1">person</data>
      <data key="d2">The Code Hearings Officer is responsible for rendering decisions on appeals related to demolition permits.&lt;SEP&gt;The Code Hearings Officer evaluates requests related to demolition permits and determines the eligibility for extensions to demolition delays.&lt;SEP&gt;The Code Hearings Officer is responsible for enforcing existing conditions related to land use approvals.</data>
      <data key="d3">chunk-c5b35452c31cb9f158ca9f1bcfd06571&lt;SEP&gt;chunk-d2eaaf54ea337fd1c606b95b01bf732d&lt;SEP&gt;chunk-4d6359633c178583bad809c59ed226cf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781097</data>
