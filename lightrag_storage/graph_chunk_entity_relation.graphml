    <node id="Step-Down Height">
      <data key="d0">Step-Down Height</data>
      <data key="d1">concept</data>
      <data key="d2">Step-Down Height refers to reduced height requirements for certain portions of buildings adjacent to specific zoning categories.&lt;SEP&gt;Step-Down Height refers to the regulations that dictate reduced height limits for structures near residential zones.</data>
      <data key="d3">chunk-199bdfd5f31802f14bb3bd7efff3a92e&lt;SEP&gt;chunk-a966c4eaabe25aca0a1be25bd188299e</data>
