      <data key="d1">legal_code</data>
      <data key="d2">This legal code outlines the rules related to asbestos management and is mentioned in relation to required asbestos surveys.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
