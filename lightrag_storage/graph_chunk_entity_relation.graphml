    </node>
    <node id="Fanno Creek Flood Zones">
      <data key="d0">Fanno Creek Flood Zones</data>
      <data key="d1">location</data>
      <data key="d2">The Fanno Creek Flood Zones are areas associated with flooding risks due to the presence of Fanno Creek.&lt;SEP&gt;Fanno Creek Flood Zones are designated flood-prone areas that require adherence to regulations regarding floodwater displacement and compensatory measures.</data>
      <data key="d3">chunk-b4860d0c2d23496924b4803e5942c793&lt;SEP&gt;chunk-df3d014b174352ce9ad5757f1156a2b1</data>
      <data key="d4">unknown_source</data>
