    <node id="General Technical Report INT-122">
      <data key="d0">General Technical Report INT-122</data>
      <data key="d1">document</data>
      <data key="d2">General Technical Report INT-122, published by the USDA Intermountain Forest and Ranger Experiment Station in 1982, provides guidelines for estimating fire behavior based on fuel models.</data>
      <data key="d3">chunk-e7e9c0aa1580e6a1ab39c745a0f5e202</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779852</data>
