      <data key="d1">concept</data>
      <data key="d2">Multi-Dwelling Buildings are residential structures designed to accommodate multiple residential units, with specific zoning regulations governing their use.</data>
      <data key="d3">chunk-cac21afda0123f450c6fc8b893e703d6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781116</data>
