    <node id="Electrical Meters">
      <data key="d0">Electrical Meters</data>
      <data key="d1">artifact</data>
      <data key="d2">Electrical meters include devices used for measuring electric usage which must be placed away from street-facing views.&lt;SEP&gt;Electrical meters include gas and water meters that have placement regulations to avoid street-facing facades.</data>
      <data key="d3">chunk-62277f559200167b441652bb61e8226f&lt;SEP&gt;chunk-3f72437166c353de768d234823279f24</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781083</data>
      <data key="d6" />
    </node>
    <node id="Storm Windows and Doors">
      <data key="d0">Storm Windows and Doors</data>
      <data key="d1">artifact</data>
      <data key="d2">Storm windows and doors are protective installations that can be installed or removed without significant alteration.</data>
      <data key="d3">chunk-62277f559200167b441652bb61e8226f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781083</data>
