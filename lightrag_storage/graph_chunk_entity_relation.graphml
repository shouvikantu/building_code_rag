      <data key="d6" />
    </node>
    <node id="Electric Vehicle Parking">
      <data key="d0">Electric Vehicle Parking</data>
      <data key="d1">concept</data>
      <data key="d2">Electric Vehicle Parking consists of designated spaces meant to accommodate electric vehicles and their charging infrastructure.</data>
      <data key="d3">chunk-6510246c4ac7809275aed03aa6705c47</data>
      <data key="d4">unknown_source</data>
