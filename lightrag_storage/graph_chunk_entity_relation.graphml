      <data key="d1">concept</data>
      <data key="d2">Prohibited Actions refer to the specific measures that a certified child care center is not allowed to use in disciplining children, including corporal punishment and harsh handling.</data>
      <data key="d3">chunk-e4ccb0f82480e6741e25e253a6be980a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781563</data>
