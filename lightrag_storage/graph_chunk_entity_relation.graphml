    <node id="Subparagraph C.4">
      <data key="d0">Subparagraph C.4</data>
      <data key="d1">concept</data>
      <data key="d2">Subparagraph C.4 describes rules for outdoor shelters in EG and I zones, including procedures for alterations and expansions.</data>
      <data key="d3">chunk-9ac355b146a97e19880b3790c5ffe83a</data>
