      <data key="d6" />
    </node>
    <node id="Height Standard">
      <data key="d0">Height Standard</data>
      <data key="d1">concept</data>
      <data key="d2">Height Standard refers to the regulations that define the maximum allowable heights for buildings in designated zones, including specific restrictions and exceptions.</data>
      <data key="d3">chunk-199bdfd5f31802f14bb3bd7efff3a92e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781009</data>
