    </node>
    <node id="Monitoring and Reporting Guidelines">
      <data key="d0">Monitoring and Reporting Guidelines</data>
      <data key="d1">concept</data>
      <data key="d2">Monitoring and Reporting Guidelines dictate that property owners are responsible for ensuring the survival of planted areas and must replace any dead plants.</data>
      <data key="d3">chunk-922c2152929ae106e2a8f4d1e7a324cf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781113</data>
