    <node id="Confirmation Testing">
      <data key="d0">Confirmation Testing</data>
      <data key="d1">method</data>
      <data key="d2">Confirmation testing is a process involving subsurface auger probes to assess the presence of archaeological resources at a site.&lt;SEP&gt;Confirmation testing is a procedure used to determine the presence of archaeological resources at a proposed development site.</data>
      <data key="d3">chunk-df192280c989d3e1d2bc59bf520124ed&lt;SEP&gt;chunk-26cd939550cd7265fc4c8d659c5ff9f9</data>
