    <node id="Table 475-2">
      <data key="d0">Table 475-2</data>
      <data key="d1">data</data>
      <data key="d2">Table 475-2 provides guidelines on tree replacement requirements and ratios for various sizes of trees removed in the River Environmental Overlay Zone.&lt;SEP&gt;Table 475-2 outlines replacement requirements for tree removal in the combined flood hazard area in relation to mitigation.</data>
