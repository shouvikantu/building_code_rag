    <node id="Gates">
      <data key="d0">Gates</data>
      <data key="d1">concept</data>
      <data key="d2">Gates are physical structures that provide entry to a property and have specific appearance regulations per local codes.&lt;SEP&gt;Gates refer to barriers that must meet specific criteria for site obscuring and outdoor lighting.</data>
      <data key="d3">chunk-9f1f1b130f7e5afceced958bf6e3d52f&lt;SEP&gt;chunk-79f19e6435928fe4a325e8a1a4cc5dd1</data>
