    <node id="Dangerous Tree">
      <data key="d0">Dangerous Tree</data>
      <data key="d1">concept</data>
      <data key="d2">Dangerous Tree refers to trees that pose a risk to safety due to their condition or location.&lt;SEP&gt;A Dangerous Tree presents a foreseeable danger of inflicting damage due to its condition and cannot be alleviated by treatment.</data>
      <data key="d3">chunk-5b7a46ce2a41072cf8f503e930128f86&lt;SEP&gt;chunk-94d2f2ba51a73a23de500a4e54b5f682</data>
