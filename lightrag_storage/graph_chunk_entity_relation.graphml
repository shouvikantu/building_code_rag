    <node id="Regional Transitways">
      <data key="d0">Regional Transitways</data>
      <data key="d1">concept</data>
      <data key="d2">Regional Transitways are major transportation routes providing service to various regions and must be connected to pedestrian pathways.</data>
      <data key="d3">chunk-bbc54ab4dbbc617d4c752a69733a5f32</data>
