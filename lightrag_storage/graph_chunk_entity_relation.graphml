    <node id="Mounting Device">
      <data key="d0">Mounting Device</data>
      <data key="d1">concept</data>
      <data key="d2">Mounting Device refers to the structure or mechanism used to attach Radio Frequency Transmission Facilities to existing structures while adhering to height limitations.</data>
