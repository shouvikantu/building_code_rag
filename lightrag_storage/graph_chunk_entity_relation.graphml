      <data key="d0">Buildings Two Stories or Greater</data>
      <data key="d1">data</data>
      <data key="d2">Buildings two stories or greater represent another classification for structural alterations with a specific cost per square foot.</data>
      <data key="d3">chunk-bad313e169428e5341b6a990dbd9f9bd</data>
