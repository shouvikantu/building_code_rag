    <node id="L4 Standard">
      <data key="d0">L4 Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The L4 Standard is intended for situations requiring extensive screening of visual and noise impacts to protect sensitive uses.</data>
      <data key="d3">chunk-54018cb95b587cdb265182d453408b50</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
