    <node id="Planning and Zoning Chapter 33.258">
      <data key="d0">Planning and Zoning Chapter 33.258</data>
      <data key="d1">concept</data>
      <data key="d2">Planning and Zoning Chapter 33.258 outlines regulations related to nonconforming situations within zoning laws.</data>
      <data key="d3">chunk-5ffecc9f384562fe6c27c733b40f0f9e</data>
