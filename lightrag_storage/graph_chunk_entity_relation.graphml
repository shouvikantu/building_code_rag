    <node id="Federal Insurance Administration">
      <data key="d0">Federal Insurance Administration</data>
      <data key="d1">organization</data>
      <data key="d2">The Federal Insurance Administration is a federal entity that relates to flood insurance and regulations concerning flood hazard areas.&lt;SEP&gt;The Federal Insurance Administration is a government body responsible for managing flood insurance and flood hazard designations.&lt;SEP&gt;The Federal Insurance Administration oversees federal flood insurance programs and floodplain management regulations.</data>
      <data key="d3">chunk-caa2864f9db143b33db40ca11a516e63&lt;SEP&gt;chunk-701594b3b5395a053d09f27e4da7dcee&lt;SEP&gt;chunk-134e99fe1ed81e0af91dacf0ec909533</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
