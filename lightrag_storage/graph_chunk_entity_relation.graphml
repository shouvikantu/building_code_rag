      <data key="d1">concept</data>
      <data key="d2">A high sensitivity area is a designated zone where archaeological resources are expected to be found and require specific regulations during development.</data>
      <data key="d3">chunk-2ef944d23c9926239972a50df6aac13f</data>
      <data key="d4">unknown_source</data>
