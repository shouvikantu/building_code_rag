    <node id="Archaeological Resource">
      <data key="d0">Archaeological Resource</data>
      <data key="d1">concept</data>
      <data key="d2">An archaeological resource refers to physical evidence from past human activities that are of historical or cultural significance, which may be identified within high sensitivity areas.&lt;SEP&gt;An archaeological resource is identified as a resource through a SHPO archaeological permit process, which may include various types such as burials, villages, seasonal campsites, or cultural use sites.&lt;SEP&gt;An archaeological resource refers to any site or artifact that provides historical or cultural significance and may be subject to evaluation and protection under state laws.</data>
      <data key="d3">chunk-2ef944d23c9926239972a50df6aac13f&lt;SEP&gt;chunk-1573af662b54921327a93cf7f0c3a073&lt;SEP&gt;chunk-26cd939550cd7265fc4c8d659c5ff9f9</data>
      <data key="d4">unknown_source</data>
