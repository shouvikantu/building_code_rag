    <node id="Park Trailers">
      <data key="d0">Park Trailers</data>
      <data key="d1">artifact</data>
      <data key="d2">Park trailers are a category of vehicles similar to manufactured homes, excluded from certain definitions for insurance purposes.</data>
      <data key="d3">chunk-0822aa249af1cada3cc5aa958e97dce7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
