      <data key="d0">Conservation Landmark Designation</data>
      <data key="d1">concept</data>
      <data key="d2">Conservation Landmark Designation is an alternative designation for resources deemed significant but not at the level of a Historic Landmark.</data>
      <data key="d3">chunk-516f4309419d52a2c0f6920e39b0dbdb</data>
      <data key="d4">unknown_source</data>
