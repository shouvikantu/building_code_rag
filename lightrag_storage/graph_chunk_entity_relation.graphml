    <node id="RM1">
      <data key="d0">RM1</data>
      <data key="d1">concept</data>
      <data key="d2">RM1 is a zoning category that specifies regulations for residential multifamily developments.&lt;SEP&gt;RM1 is a residential zoning designation that determines specific step-down height limits.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e&lt;SEP&gt;chunk-bb053937b4fd6958f885edbd491a92e1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781056</data>
      <data key="d6" />
    </node>
    <node id="RMP">
      <data key="d0">RMP</data>
      <data key="d1">concept</data>
      <data key="d2">RMP is a zoning category that governs residential mixed-use properties and their associated characteristics.&lt;SEP&gt;RMP is a residential mixed use zoning designation that interfaces between residential and commercial standards.&lt;SEP&gt;RMP is another residential zoning designation affecting the step-down height regulations.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e&lt;SEP&gt;chunk-bb053937b4fd6958f885edbd491a92e1&lt;SEP&gt;chunk-cbb810e875d66f848b351a4f1271e2a7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781056</data>
      <data key="d6" />
    </node>
    <node id="CM1">
      <data key="d0">CM1</data>
      <data key="d1">concept</data>
      <data key="d2">CM1 is a zoning designation that allows specific height and density regulations in development standards.&lt;SEP&gt;CM1 is a commercial zoning classification with unique height allowances for parapets and railings.&lt;SEP&gt;CM1 is the designation for a specific Mixed Use zoning classification that outlines regulations for developments.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e&lt;SEP&gt;chunk-bb053937b4fd6958f885edbd491a92e1&lt;SEP&gt;chunk-f8dedd6570aca440bb011dbffebca8f0</data>
      <data key="d4">unknown_source</data>
