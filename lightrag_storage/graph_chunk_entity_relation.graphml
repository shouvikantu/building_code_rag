    <node id="National Flood Insurance Program">
      <data key="d0">National Flood Insurance Program</data>
      <data key="d1">organization</data>
      <data key="d2">The National Flood Insurance Program establishes criteria for flood insurance and manages related variances.&lt;SEP&gt;The National Flood Insurance Program provides guidelines for variances related to flood elevations and property zoning laws.</data>
      <data key="d3">chunk-43230c8c64a3e12675c36b28cd80b9f7&lt;SEP&gt;chunk-8ba12577414f8d5a3adb28727f2e0ff6</data>
