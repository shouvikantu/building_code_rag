    <node id="CR Zone">
      <data key="d0">CR Zone</data>
      <data key="d1">concept</data>
      <data key="d2">The CR Zone is a specific zoning designation that imposes limitations on Retail Sales and Service uses regarding size and operational hours.&lt;SEP&gt;The CR Zone is a zoning classification that does not require stepped-down height standards.&lt;SEP&gt;CR Zone refers to a zoning classification where exterior display of goods is not permitted.&lt;SEP&gt;CR Zone refers to a commercial residential zoning classification that imposes regulations on helicopter landing facilities.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e&lt;SEP&gt;chunk-8aafe5a7a2907664ceccb93037cc2fb8&lt;SEP&gt;chunk-247549d54269808af0150d94edb52c47&lt;SEP&gt;chunk-49d1779dc70c5faec44a2798d3eb478c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781056</data>
      <data key="d6" />
    </node>
    <node id="RF through R2.5">
      <data key="d0">RF through R2.5</data>
      <data key="d1">concept</data>
      <data key="d2">RF through R2.5 are residential zoning designations that influence height limits for adjacent developments.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781056</data>
