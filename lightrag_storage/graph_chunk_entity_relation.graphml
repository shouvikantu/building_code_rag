    <node id="Type A Marquam Hill Parking Review">
      <data key="d0">Type A Marquam Hill Parking Review</data>
      <data key="d1">concept</data>
      <data key="d2">Type A Marquam Hill Parking Review is a designation required for all proposals that include parking within the Marquam Hill area.&lt;SEP&gt;A Type A Marquam Hill Parking Review is an assessment process for parking arrangements that is streamlined for quicker approval.</data>
      <data key="d3">chunk-40e6e0a14b42f25e67a43e11831d8486&lt;SEP&gt;chunk-4670488f256f231024de0291feeec277</data>
      <data key="d4">unknown_source</data>
