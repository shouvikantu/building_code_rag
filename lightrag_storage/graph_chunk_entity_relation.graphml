    <node id="Fees">
      <data key="d0">Fees</data>
      <data key="d1">concept</data>
      <data key="d2">Fees refer to charges related to applications, services, or permits required in land use management.&lt;SEP&gt;Fees refer to the applicable filing fees required during the application process for middle housing land divisions.&lt;SEP&gt;Fees refer to the applicable charges that must be paid as part of the filing process for land use applications.</data>
      <data key="d3">chunk-bdee8c33d0d52a7455e70087137ca492&lt;SEP&gt;chunk-8d7961ce66e26136990bb4bb54c838e8&lt;SEP&gt;chunk-dd5e24f7c98b2b609a3ed6656b608420</data>
