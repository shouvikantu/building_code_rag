    <node id="Private Well">
      <data key="d0">Private Well</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A private well serves as an alternative water source for certified child care centers, requiring regular testing for safety.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781563</data>
      <data key="d6" />
    </node>
    <node id="Lead">
      <data key="d0">Lead</data>
      <data key="d1">concept</data>
      <data key="d2">Lead is a toxic substance that must be tested for in drinking water at certified child care centers to ensure safety.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781563</data>
