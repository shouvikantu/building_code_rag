    <node id="Montgomery Park Area Plan Public Benefits Agreement">
      <data key="d0">Montgomery Park Area Plan Public Benefits Agreement</data>
      <data key="d1">concept</data>
      <data key="d2">The Montgomery Park Area Plan Public Benefits Agreement outlines conditions under which nonresidential use requirements can be reduced.&lt;SEP&gt;The Montgomery Park Area Plan Public Benefits Agreement outlines the commitments for public benefits including the development of affordable housing.&lt;SEP&gt;The Montgomery Park Area Plan Public Benefits Agreement outlines provisions for public benefits, including publicly accessible parks or open spaces in the Montgomery Park area.</data>
      <data key="d3">chunk-861d2a39c6243daf2d9eb704cb764a04&lt;SEP&gt;chunk-4ff630c9a267554d2f1236df690069f6&lt;SEP&gt;chunk-e691024552ab10508d9e2848f48d8859</data>
      <data key="d4">unknown_source</data>
