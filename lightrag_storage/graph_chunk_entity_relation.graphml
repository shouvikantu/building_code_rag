    </node>
    <node id="NE Mt. Hood Avenue">
      <data key="d0">NE Mt. Hood Avenue</data>
      <data key="d1">location</data>
      <data key="d2">NE Mt. Hood Avenue is a street associated with restrictions on Quick Vehicle Service facilities in Subdistrict A.</data>
