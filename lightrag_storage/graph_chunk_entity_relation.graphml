      <data key="d0">Height and Floor Area Ratio Bonuses for Affordable Housing</data>
      <data key="d1">concept</data>
      <data key="d2">Height and floor area ratio bonuses for affordable housing provide specific incentives for residential developments under certain regulations.</data>
      <data key="d3">chunk-c07c29cf0579682841d3d14fca9fead2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781097</data>
