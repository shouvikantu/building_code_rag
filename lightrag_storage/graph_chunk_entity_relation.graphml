      <data key="d0">Main Assembly Area</data>
      <data key="d1">concept</data>
      <data key="d2">The Main Assembly Area refers to a designated space where assembly-related activities occur and has specified parking requirements.</data>
      <data key="d3">chunk-16b2323b48f41f87137658c4c38c98ae</data>
      <data key="d4">unknown_source</data>
