      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="Pearl District">
      <data key="d0">Pearl District</data>
      <data key="d1">location</data>
      <data key="d2">The Pearl District is a subdistrict featuring specific zoning regulations for development and use.&lt;SEP&gt;The Pearl District is a specific neighborhood where certain ground floor active use standards apply, particularly regarding parking and building design.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e&lt;SEP&gt;chunk-91db399b32e598af5683382ecc53fa6a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="West End">
      <data key="d0">West End</data>
      <data key="d1">location</data>
      <data key="d2">The West End is another subdistrict with zoning regulations related to building and development standards.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="Occupancy Permit">
      <data key="d0">Occupancy Permit</data>
      <data key="d1">document</data>
      <data key="d2">An occupancy permit is required for new developments, ensuring compliance with zoning and planning standards.&lt;SEP&gt;The Occupancy Permit is an official approval allowing for occupancy of a building after confirming that all development standards have been met.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e&lt;SEP&gt;chunk-fbcf1c43cb59d25662f5af1b9ac994a8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="Ecoroofs">
      <data key="d0">Ecoroofs</data>
      <data key="d1">concept</data>
      <data key="d2">Ecoroofs provide ecological benefits and are designed to enhance urban areas by managing stormwater and improving air quality.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="Map 510-13">
      <data key="d0">Map 510-13</data>
      <data key="d1">data</data>
      <data key="d2">Map 510-13 shows streetcar alignments pertinent to restrictions on parking in certain portions of buildings.&lt;SEP&gt;Map 510-13 is utilized to identify sites within 100 feet of a streetcar alignment where parking regulations apply.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e&lt;SEP&gt;chunk-91db399b32e598af5683382ecc53fa6a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
      <data key="d6" />
    </node>
    <node id="Regional Public Attraction">
      <data key="d0">Regional Public Attraction</data>
      <data key="d1">concept</data>
      <data key="d2">A regional public attraction includes attractions like museums or aquariums that impact zoning and site development standards.</data>
      <data key="d3">chunk-2d2c06f5978724095d6914de0f870d8e</data>
      <data key="d4">unknown_source</data>
