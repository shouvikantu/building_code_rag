      <data key="d4">unknown_source</data>
      <data key="d5">1768781113</data>
      <data key="d6" />
    </node>
    <node id="Metro Regional Land Use Framework Map">
      <data key="d0">Metro Regional Land Use Framework Map</data>
      <data key="d1">data</data>
      <data key="d2">The Metro Regional Land Use Framework Map designates lands for the application and removal of zoning, including the Future Urban Zone.</data>
      <data key="d3">chunk-9916243fd6ec8d5d7a01e1c0d8f2bd77</data>
      <data key="d4">unknown_source</data>
