    <node id="Height Limits">
      <data key="d0">Height Limits</data>
      <data key="d1">concept</data>
      <data key="d2">Height Limits are the maximum allowable heights for various structures as defined in zoning regulations.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e</data>
      <data key="d4">unknown_source</data>
