    <node id="Hoses and Conduits">
      <data key="d0">Hoses and Conduits</data>
      <data key="d1">concept</data>
      <data key="d2">Hoses and conduits are pipes or tubes that must comply with size limitations and placement restrictions on facades.</data>
      <data key="d3">chunk-62277f559200167b441652bb61e8226f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781083</data>
