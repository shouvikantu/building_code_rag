    <node id="Staff">
      <data key="d0">Staff</data>
      <data key="d1">person</data>
      <data key="d2">Staff refers to individuals employed at the certified child care center responsible for the daily care and supervision of children.&lt;SEP&gt;Staff refers to employees or volunteers present at a child care center for extended periods, responsible for child care.&lt;SEP&gt;Staff in a Certified Child Care Center are responsible for actively supervising children and fostering a safe, responsive environment.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37&lt;SEP&gt;chunk-d71ecbdda9f0050185892674522421a1&lt;SEP&gt;chunk-b60c35b5c4ccdef38598f6b916ce964a</data>
