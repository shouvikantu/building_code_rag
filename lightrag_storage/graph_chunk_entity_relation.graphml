    <node id="Public View Corridor">
      <data key="d0">Public View Corridor</data>
      <data key="d1">method</data>
      <data key="d2">The Public View Corridor is a planned pathway that provides visibility between public streets and existing natural features.</data>
      <data key="d3">chunk-04cb5d072ac6b2a3e906facf4052c5aa</data>
      <data key="d4">unknown_source</data>
