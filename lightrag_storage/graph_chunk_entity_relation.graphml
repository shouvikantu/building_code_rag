    <node id="Cemetery">
      <data key="d0">Cemetery</data>
      <data key="d1">location</data>
      <data key="d2">A Cemetery is a burial ground where soil removal may occur for burial plots, subject to specific regulations.&lt;SEP&gt;A cemetery is an open space designated for burial, entombment, cremation, or funeral purposes.&lt;SEP&gt;A Cemetery is an open space site designated for various burial and funeral purposes.</data>
      <data key="d3">chunk-70d37b0db2824c732a3a9a02ff910d85&lt;SEP&gt;chunk-11738f034d5f65fb344c5bf37019ca51&lt;SEP&gt;chunk-68c858bb23efe67cb70612c0464f3e80</data>
