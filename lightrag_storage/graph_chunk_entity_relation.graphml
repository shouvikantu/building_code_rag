    <node id="Portland City Code Title 33, Chapter 33.700">
      <data key="d0">Portland City Code Title 33, Chapter 33.700</data>
      <data key="d1">legal_code</data>
      <data key="d2">Portland City Code Title 33, Chapter 33.700 outlines the administration rules and requirements for permits and development in Portland.</data>
      <data key="d3">chunk-c5adf814a146242df9673b129a2f1e89</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
