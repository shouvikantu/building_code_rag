    <node id="Deeper Housing Affordability Bonus Option">
      <data key="d0">Deeper Housing Affordability Bonus Option</data>
      <data key="d1">concept</data>
      <data key="d2">The deeper housing affordability bonus option is a specific bonus available in Subdistrict D for height adjustments intended to support affordable housing.</data>
      <data key="d3">chunk-4e156b5dd560d7dd7cf18d1c12b0bb44</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781071</data>
