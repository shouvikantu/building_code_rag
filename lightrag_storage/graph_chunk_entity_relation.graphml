    <node id="L5 Standard">
      <data key="d0">L5 Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The L5 Standard is designed to separate uses by both distance and sight while providing extensive screening.</data>
      <data key="d3">chunk-54018cb95b587cdb265182d453408b50</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781122</data>
