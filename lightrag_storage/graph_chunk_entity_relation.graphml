    <node id="Electric Bike Chargers">
      <data key="d0">Electric Bike Chargers</data>
      <data key="d1">artifact</data>
      <data key="d2">Electric bike chargers are devices installed to provide charging facilities for electric bicycles as part of development requirements.</data>
