      <data key="d5">1768781054</data>
      <data key="d6" />
    </node>
    <node id="Dangerous Structure">
      <data key="d0">Dangerous Structure</data>
      <data key="d1">concept</data>
      <data key="d2">A dangerous structure is a building that poses a threat to life, health, or safety due to various conditions or defects defined in code.</data>
      <data key="d3">chunk-5d061032da80389dd5b777b1e5e8bc61</data>
