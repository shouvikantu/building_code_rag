      <data key="d1">location</data>
      <data key="d2">The South Reach is a designated area where the bird-safe glazing standards are implemented for new buildings and renovations.</data>
      <data key="d3">chunk-60b9ffdb955ab3944250655ae5423afa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781083</data>
