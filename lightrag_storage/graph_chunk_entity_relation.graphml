    <node id="Greenway Development Standards">
      <data key="d0">Greenway Development Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Greenway Development Standards are regulations applicable to development activities within the greenway, aiming to protect natural resources.</data>
      <data key="d3">chunk-11138328735cf87d245bb64f2a57f4d9</data>
