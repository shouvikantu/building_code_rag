76f6a4ff3953570df7a&lt;SEP&gt;chunk-30acaad3495315145b81fed5d7cb9158&lt;SEP&gt;chunk-5169c21d505e8c064ac1ba9c16c3eb50&lt;SEP&gt;chunk-3404eafc9757fc05febd370a1ac85737&lt;SEP&gt;chunk-23a93319af7a8f643cc123f328935418&lt;SEP&gt;chunk-80cb4c4524db16a443cea9724f5fd6fc&lt;SEP&gt;chunk-b5e32407319712c8e952f9496e61eac1&lt;SEP&gt;chunk-1c127588b3effb62124f2b4367f10741&lt;SEP&gt;chunk-33f6d86139e9f8ebbadc462769659fed&lt;SEP&gt;chunk-f63396adc71a2e9185adb3bc7b8db5ad&lt;SEP&gt;chunk-75b2c3f3b605bc9f877b7485abc23364&lt;SEP&gt;chunk-a6144b313ccb84dbccd73dbf4dd1e5c6&lt;SEP&gt;chunk-0e7822437163e35b6c56d5560ac87ff1&lt;SEP&gt;chunk-7777fdca5bcbd3670723d206cd8f5757&lt;SEP&gt;chunk-133e0d785413e64759688100094b7c2e&lt;SEP&gt;chunk-3687e34f528a78261767a8a0c1b6b6fc&lt;SEP&gt;chunk-8e1b5dababc725aeec628685254c591a&lt;SEP&gt;chunk-b8fd3cd43b3e7770531d9235f454d5b9&lt;SEP&gt;chunk-f976aff1b8a931aa89584cca89b6bd36&lt;SEP&gt;chunk-2653802c982b64f8a7af01800f4406b1&lt;SEP&gt;chunk-4ab68c6faa3af9af6f5cd876312e30c7&lt;SEP&gt;chunk-d4d54757bbd8eb99b2b0cd39a957603d&lt;SEP&gt;chunk-b79a4fda2a7ebb04a6a59cff745526b5&lt;SEP&gt;chunk-f3994dbc2c6f464ef189000d5ce6654c&lt;SEP&gt;chunk-2001ba277158737c9b888248e680d7ee&lt;SEP&gt;chunk-3f2df84aea0e28175d739f9e39d7ac73&lt;SEP&gt;chunk-6c623ec1ba96e21d348f6cf747ed9156&lt;SEP&gt;chunk-594964a698a9063f34a66127a99f84d2&lt;SEP&gt;chunk-599508fe86fb4e6ee4dd67e02ddb8b50&lt;SEP&gt;chunk-b2003f93c2ff07e93de1875ffe1520e0&lt;SEP&gt;chunk-b2546da1b6188ab781e1777780334eb3&lt;SEP&gt;chunk-c7f9cce1f67d8125895ea396b1acc241&lt;SEP&gt;chunk-8f7d373987e115c5189e0f34f1774910&lt;SEP&gt;chunk-4177bfbc917fc82fda498c4d1f0e571f&lt;SEP&gt;chunk-cfe92a3f46b3bfc4baa1f040d200709a&lt;SEP&gt;chunk-550081f2dd423e67b6d83d9a91ecd5c3&lt;SEP&gt;chunk-225b86068366c52c4915a3742fa8cb4a&lt;SEP&gt;chunk-49acd712739227babe51a65cf9f9e8be&lt;SEP&gt;chunk-9a652fe26732ad48c0b07b16d7b74511&lt;SEP&gt;chunk-ca18882d6a8207dec4b469f7a2654fd4&lt;SEP&gt;chunk-8034fc51f3b39a89498e8a31263eac35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781015</data>
      <data key="d6" />
    </node>
    <node id="Bureau">
      <data key="d0">Bureau</data>
      <data key="d1">organization</data>
      <data key="d2">The Bureau is involved in the application and interpretation of the Building Code in Portland, and its decisions can be appealed to the Administrative Appeal Board.&lt;SEP&gt;The Bureau conducts inspections and issues correction notices for minor commercial and industrial labels.&lt;SEP&gt;The Bureau is involved in notifying about boundary alterations and managing flood hazard boundary maps.&lt;SEP&gt;The Bureau oversees the appeals process related to the demolition permit applications.&lt;SEP&gt;The Bureau oversees the acceptance of demolition permit applications and may issue permits based on regulatory compliance.&lt;SEP&gt;The Bureau manages applications and interpretations of codes related to manufactured dwellings and addresses administrative appeals.&lt;SEP&gt;The Bureau reviews and approves reports and plans concerning mitigation success in relation to natural resource management.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee&lt;SEP&gt;chunk-f2934c450fcc75ab9c66c0de792267b0&lt;SEP&gt;chunk-4ad23b4588f34612e5e3486591895965&lt;SEP&gt;chunk-c5b35452c31cb9f158ca9f1bcfd06571&lt;SEP&gt;chunk-65d97f5eef5c0648c052fbe7643fc599&lt;SEP&gt;chunk-d2eaaf54ea337fd1c606b95b01bf732d&lt;SEP&gt;chunk-ca18882d6a8207dec4b469f7a2654fd4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781159</data>
      <data key="d6" />
    </node>
    <node id="Sewage System Administrator">
      <data key="d0">Sewage System Administrator</data>
      <data key="d1">person</data>
      <data key="d2">Sewage System Administrator is the official responsible for identifying floodway boundaries for unidentified watercourses.&lt;SEP&gt;Sewage System Administrator is the designated individual responsible for regulating public sanitary and stormwater facilities.&lt;SEP&gt;The Sewage System Administrator is a professional responsible for approving technical analyses related to sewage systems.&lt;SEP&gt;The Sewage System Administrator reviews technical analyses related to floodway encroachments and approvals.&lt;SEP&gt;The Sewage System Administrator is responsible for overseeing flood hazard data and ensuring compliance with flood management regulations.&lt;SEP&gt;The Sewage System Administrator is responsible for reviewing and utilizing flood elevation data for flood risk management.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee&lt;SEP&gt;chunk-0822aa249af1cada3cc5aa958e97dce7&lt;SEP&gt;chunk-cbba9ae1b324ef0410472174c02e9e9d&lt;SEP&gt;chunk-1db63c93213cb06b155d2b22811e90c9&lt;SEP&gt;chunk-eaf6bc29b8214191b42a335cb7e2fc17&lt;SEP&gt;chunk-21ee09234912e67470de67393ca93ace</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Conditional Letter of Map Revision (CLOMR)">
      <data key="d0">Conditional Letter of Map Revision (CLOMR)</data>
      <data key="d1">document</data>
      <data key="d2">A CLOMR is submitted to the Federal Insurance Administration as part of the floodplain management and regulatory process.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Letter of Map Revision (LOMR)">
      <data key="d0">Letter of Map Revision (LOMR)</data>
      <data key="d1">document</data>
      <data key="d2">A LOMR is required to be sent to FEMA after the completion of projects that received a CLOMR.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Floodway">
      <data key="d0">Floodway</data>
      <data key="d1">concept</data>
      <data key="d2">Floodway is the channel of a river and adjacent areas reserved to discharge floodwaters without increasing water levels significantly.&lt;SEP&gt;Floodway is an area that carries floodwaters and requires specific compensatory volume calculations when floodwaters are displaced.&lt;SEP&gt;The floodway is the channel and adjacent areas of a river or stream that must remain clear of encroachments to prevent flooding.&lt;SEP&gt;Floodway is a specific area within the Flood Hazard Area that impacts property line adjustments and development standards.&lt;SEP&gt;Floodway is the active channel during a flood, including designated areas that must be reserved to prevent increased water surface elevation during base floods.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee&lt;SEP&gt;chunk-1db63c93213cb06b155d2b22811e90c9&lt;SEP&gt;chunk-25a47da3153ff3a91ef0d0af937548b1&lt;SEP&gt;chunk-83e6483ee1a0cf1415621eb7ccf6224b&lt;SEP&gt;chunk-d06cb95ab17fc909ffe773dee0f0a731</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781103</data>
      <data key="d6" />
    </node>
    <node id="Flood Insurance Rate Maps (FIRM)">
      <data key="d0">Flood Insurance Rate Maps (FIRM)</data>
      <data key="d1">document</data>
      <data key="d2">Flood Insurance Rate Maps (FIRM) are used to determine flood insurance requirements and risks within specific areas.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Flood Insurance Study">
      <data key="d0">Flood Insurance Study</data>
      <data key="d1">document</data>
      <data key="d2">Flood Insurance Study is the official report from the Federal Insurance Administration detailing flooding information and engineering methods.&lt;SEP&gt;The Flood Insurance Study is an official report by the Federal Insurance Administration containing information about flooding and methods used to create Flood Insurance Rate Maps.&lt;SEP&gt;Flood Insurance Study is the official report prepared by the Federal Insurance Administration regarding flood risks in specified Oregon counties.&lt;SEP&gt;The Flood Insurance Study provides assessments of flood risks and outlines regulatory requirements based on flood hazard areas.&lt;SEP&gt;The Flood Insurance Study is a source that can provide elevation data relevant to flood management.&lt;SEP&gt;The Flood Insurance Study is a comprehensive assessment used to determine flood hazard areas and the associated flood management requirements within those regions.</data>
      <data key="d3">chunk-701594b3b5395a053d09f27e4da7dcee&lt;SEP&gt;chunk-cbba9ae1b324ef0410472174c02e9e9d&lt;SEP&gt;chunk-1db63c93213cb06b155d2b22811e90c9&lt;SEP&gt;chunk-df3d014b174352ce9ad5757f1156a2b1&lt;SEP&gt;chunk-134e99fe1ed81e0af91dacf0ec909533&lt;SEP&gt;chunk-21ee09234912e67470de67393ca93ace</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Burnside Street">
      <data key="d0">Burnside Street</data>
      <data key="d1">location</data>
      <data key="d2">Burnside Street serves as the east and west base line for numbering on streets running north and south in a specified city plan.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Chapter 24.75">
      <data key="d0">Chapter 24.75</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 24.75 addresses the Uniform Building Address System and its requirements.&lt;SEP&gt;Chapter 24.75 establishes a uniform numbering system for buildings along streets and includes guidelines for placing building numbers.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e&lt;SEP&gt;chunk-7e8c1c7b39585a7a7e3106344983f67e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Chapter 24.85">
      <data key="d0">Chapter 24.85</data>
      <data key="d1">concept</data>
      <data key="d2">Chapter 24.85 outlines seismic design requirements for existing buildings undergoing various changes or repairs.&lt;SEP&gt;Chapter 24.85 pertains to Interim Seismic Design Requirements applicable to existing buildings.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e&lt;SEP&gt;chunk-05ab6bd54c89f86d004823d37a33255e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781082</data>
      <data key="d6" />
    </node>
    <node id="Building Numbering System">
      <data key="d0">Building Numbering System</data>
      <data key="d1">concept</data>
      <data key="d2">The Building Numbering System provides guidelines on how to number properties based on their location and side of the street.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Property Owner or Agent">
      <data key="d0">Property Owner or Agent</data>
      <data key="d1">person</data>
      <data key="d2">The Property Owner or Agent is responsible for adhering to building number regulations and ensuring that assigned numbers are displayed correctly.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="City Code">
      <data key="d0">City Code</data>
      <data key="d1">concept</data>
      <data key="d2">The City Code is a comprehensive framework of regulations that governs various aspects of building structures, conditions, and land use within a city. It encompasses a set of legal provisions that ensure safety, compliance, and orderly development in the jurisdiction. 

Specifically, the City Code addresses regulations related to building structures and safety standards, as well as city planning requirements, such as building numbering. It includes specific guidelines for urban planning and zoning, along with operational standards for various facilities, which notably incorporate noise control and vibration standards. Additionally, it sets forth regulations pertaining to parking management.

Furthermore, the City Code contains detailed provisions regarding land use and environmental compliance, including the enforcement of penalties for violations. This extends to specific legislative aspects like enforcement penalties concerning the River Environmental Overlay Zone regulations. The City Code also outlines critical requirements for submissions related to Final Plats, thus ensuring that all developments comply with established planning and zoning regulations.

Overall, the City Code serves as an essential legal document that governs property use, development regulations, and compliance standards, aiming to promote sustainable and organized urban growth.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e&lt;SEP&gt;chunk-7e8c1c7b39585a7a7e3106344983f67e&lt;SEP&gt;chunk-a78f1876fb134d98c03a24e26b94fa88&lt;SEP&gt;chunk-84efb40ac49907b061aeb00bb2d08948&lt;SEP&gt;chunk-187fab99be5d8e40e38df505230ff13b&lt;SEP&gt;chunk-d771f61eac49b01fc5796204c75025ef&lt;SEP&gt;chunk-f5a5816615430d9b588c4adaf4aa3131&lt;SEP&gt;chunk-2c77c0e594bc319fd143848146f9ea56&lt;SEP&gt;chunk-24ca5b72e1693d958a1e3c385272e963&lt;SEP&gt;chunk-49d1779dc70c5faec44a2798d3eb478c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781048</data>
      <data key="d6" />
    </node>
    <node id="Code Enforcement Hearings Officer">
      <data key="d0">Code Enforcement Hearings Officer</data>
      <data key="d1">person</data>
      <data key="d2">The Code Enforcement Hearings Officer oversees actions related to compliance and enforcement of city regulations, as mentioned in the Chapter.</data>
      <data key="d3">chunk-27624e43bed080783f32570c691eed2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Seismic Design Requirements">
      <data key="d0">Seismic Design Requirements</data>
      <data key="d1">concept</data>
      <data key="d2">Seismic Design Requirements are the guidelines set forth for the seismic design of existing buildings undergoing various modifications or repairs.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="State of Oregon Structural Specialty Code">
      <data key="d0">State of Oregon Structural Specialty Code</data>
      <data key="d1">concept</data>
      <data key="d2">The State of Oregon Structural Specialty Code outlines the building standards and structural requirements that apply within Oregon.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="PP&amp;D Engineering">
      <data key="d0">PP&amp;D Engineering</data>
      <data key="d1">organization</data>
      <data key="d2">PP&amp;D Engineering is the department that offers support to building owners by reviewing seismic strengthening plans with their design engineers.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="ASCE 41">
      <data key="d0">ASCE 41</data>
      <data key="d1">concept</data>
      <data key="d2">ASCE 41 refers to the Seismic Evaluation and Retrofit of Existing Buildings, providing standards for evaluating earthquake risks.&lt;SEP&gt;ASCE 41 is a standard that outlines procedures for assessing and improving the seismic performance of existing buildings.&lt;SEP&gt;ASCE 41 refers to the standard for seismic rehabilitation of existing buildings, outlining improvement standards for structural safety.&lt;SEP&gt;ASCE 41 is an improvement standard for evaluating and enhancing the lateral support systems of buildings to withstand seismic forces.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3&lt;SEP&gt;chunk-ffa3eb9ed7fae286e6c7cbef13d5c1e6&lt;SEP&gt;chunk-5902d8c6d32e1e8323685d7234c2507e&lt;SEP&gt;chunk-cf7b1be8af44bb34ea4e9d761716215e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Basic Performance Objective for Existing Buildings (BPOE)">
      <data key="d0">Basic Performance Objective for Existing Buildings (BPOE)</data>
      <data key="d1">concept</data>
      <data key="d2">BPOE serves as a performance objective framework used to evaluate existing buildings against seismic risks.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Basic Performance Objective Equivalent to New Buildings (BPON)">
      <data key="d0">Basic Performance Objective Equivalent to New Buildings (BPON)</data>
      <data key="d1">concept</data>
      <data key="d2">BPON is the performance standard aimed at achieving seismic design objectives equivalent to new buildings.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Applied Technology Council">
      <data key="d0">Applied Technology Council</data>
      <data key="d1">organization</data>
      <data key="d2">The Applied Technology Council publishes guidelines including the Procedures for Post Earthquake Safety Evaluation of Buildings.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779847</data>
      <data key="d6" />
    </node>
    <node id="Basic Safety Earthquake-1 (BSE-1E)">
      <data key="d0">Basic Safety Earthquake-1 (BSE-1E)</data>
      <data key="d1">concept</data>
      <data key="d2">BSE-1E defines a seismic hazard level with a specific probability of exceedance used in conjunction with BPOE.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779848</data>
      <data key="d6" />
    </node>
    <node id="Basic Safety Earthquake-2 (BSE-2E)">
      <data key="d0">Basic Safety Earthquake-2 (BSE-2E)</data>
      <data key="d1">concept</data>
      <data key="d2">BSE-2E establishes another seismic hazard level specifically tailored for existing buildings within the BPOE framework.</data>
      <data key="d3">chunk-d1181e93e3ba7fdfb58d698c66f4dbf3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779848</data>
      <data key="d6" />
    </node>
