    <node id="Maximum Lot Area Standard">
      <data key="d0">Maximum Lot Area Standard</data>
      <data key="d1">concept</data>
      <data key="d2">The maximum lot area standard restricts the largest size a lot can be developed to under zoning regulations.</data>
      <data key="d3">chunk-fb1ab98a275a3e96b292afb310b8237d</data>
