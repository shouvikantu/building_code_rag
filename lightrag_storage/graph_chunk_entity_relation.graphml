    <node id="Chapter 33.410">
      <data key="d0">Chapter 33.410</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 33.410 details the purposes and standards for the Buffer Zone, effective from 3/1/25.</data>
      <data key="d3">chunk-2f2e828d0ef40701ea87d62c0b01bd2f</data>
      <data key="d4">unknown_source</data>
