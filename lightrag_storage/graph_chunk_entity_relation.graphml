    <node id="Oregon">
      <data key="d0">Oregon</data>
      <data key="d1">location</data>
      <data key="d2">Oregon is a U.S. state where regulations regarding noise insulation must be certified by engineers registered in the state.&lt;SEP&gt;Oregon is the U.S. state associated with specific child care laws mentioned in the regulations.</data>
      <data key="d3">chunk-24f1dbc710e403c474cc362ea8160571&lt;SEP&gt;chunk-7b7b17c24300e18201fee673b061b7da</data>
