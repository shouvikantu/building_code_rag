    <node id="Elrod Slough">
      <data key="d0">Elrod Slough</data>
      <data key="d1">location</data>
      <data key="d2">Elrod Slough is included in the regulations for vehicle or pedestrian crossings, highlighting its geographical significance.</data>
      <data key="d3">chunk-539f4010f687efe24bc7e2b559aec360</data>
