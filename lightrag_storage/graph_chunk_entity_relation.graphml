    </node>
    <node id="Paragraphs B.3. and B.4.">
      <data key="d0">Paragraphs B.3. and B.4.</data>
      <data key="d1">concept</data>
      <data key="d2">Paragraphs B.3. and B.4. specify conditions under which the removal of a Historic Landmark designation is permissible.</data>
      <data key="d3">chunk-516f4309419d52a2c0f6920e39b0dbdb</data>
