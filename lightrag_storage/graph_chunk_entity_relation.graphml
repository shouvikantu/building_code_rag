    <node id="Pedestrian Connections">
      <data key="d0">Pedestrian Connections</data>
      <data key="d1">concept</data>
      <data key="d2">Pedestrian Connections are pathways intended to facilitate foot traffic between designated streets and neighborhood facilities.&lt;SEP&gt;Pedestrian Connections are pathways intended for foot traffic to enhance access between streets and areas within the land division.&lt;SEP&gt;Pedestrian Connections refer to the routes designed for foot traffic linking key transit and recreational sites.</data>
      <data key="d3">chunk-bbc54ab4dbbc617d4c752a69733a5f32&lt;SEP&gt;chunk-7014f2d99071dd5f926719c5b91b21ed&lt;SEP&gt;chunk-382ea5f9bd1d1962a9c0ded6051b139a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781017</data>
