    <node id="Site Inspection">
      <data key="d0">Site Inspection</data>
      <data key="d1">concept</data>
      <data key="d2">Site inspection is the process undertaken to verify a site's compliance with development standards before permit approval.</data>
      <data key="d3">chunk-28182b619a9a912d117b6795858e20f7</data>
      <data key="d4">unknown_source</data>
