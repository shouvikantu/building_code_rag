      <data key="d0">900 Square Feet</data>
      <data key="d1">data</data>
      <data key="d2">The maximum building coverage allowed for each dwelling unit in a cottage cluster is 900 square feet.</data>
      <data key="d3">chunk-59644a82d0120b0f13d2a9d402862b9b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781082</data>
