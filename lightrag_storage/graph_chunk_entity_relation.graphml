      <data key="d0">Nitrates</data>
      <data key="d1">concept</data>
      <data key="d2">Nitrates are chemicals whose levels must be monitored in water sources used by certified child care centers to ensure health compliance.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
