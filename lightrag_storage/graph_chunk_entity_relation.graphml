    <node id="Category Two">
      <data key="d0">Category Two</data>
      <data key="d1">category</data>
      <data key="d2">Category Two includes food vendors who sell food items but do not meet the criteria of Category One.&lt;SEP&gt;Category Two includes market vendors such as cheesemakers who do not raise their own animals, related to food production.</data>
      <data key="d3">chunk-771b4e43ed85ad89f1a85f922b03dcac&lt;SEP&gt;chunk-cc1a993d28187168df19c579664230fc</data>
      <data key="d4">unknown_source</data>
