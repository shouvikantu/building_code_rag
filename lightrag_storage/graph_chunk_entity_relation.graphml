    <node id="Demolition Permit Application">
      <data key="d0">Demolition Permit Application</data>
      <data key="d1">concept</data>
      <data key="d2">The demolition permit application is a formal request concerning the demolition of structures that undergo regulatory scrutiny for potential significance and alternatives to demolition.</data>
      <data key="d3">chunk-c5b35452c31cb9f158ca9f1bcfd06571</data>
