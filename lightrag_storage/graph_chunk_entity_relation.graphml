    <node id="Retail Sales And Services">
      <data key="d0">Retail Sales And Services</data>
      <data key="d1">concept</data>
      <data key="d2">Retail Sales And Services refer to a specific category within the commercial use classification, defining conditional use reviews required for certain situations.&lt;SEP&gt;Retail Sales And Services include commercial activities allowed on institutional campuses under specific regulatory conditions.</data>
      <data key="d3">chunk-809d9f51e6409fec41d4c184732a13b2&lt;SEP&gt;chunk-64e2adfc473177ee34daf0edf44e9fab</data>
