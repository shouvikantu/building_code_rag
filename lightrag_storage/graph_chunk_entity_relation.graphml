    </edge>
    <edge source="Radio Frequency Transmission Facilities" target="F2 Standard">
      <data key="d7">1.0</data>
      <data key="d8">Radio Frequency Transmission Facilities must conform to the F2 Standard for screening from adjacent properties.</data>
      <data key="d9">compliance standard,screening requirement</data>
      <data key="d10">chunk-1e0d3aa49a8c3edf6ae58238049a8d3b</data>
