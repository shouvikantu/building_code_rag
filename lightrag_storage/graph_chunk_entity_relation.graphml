    <node id="Tree Grove">
      <data key="d0">Tree Grove</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A tree grove is a group of six or more native trees that form a generally continuous canopy, providing habitat and environmental functions.</data>
      <data key="d3">chunk-5b7a46ce2a41072cf8f503e930128f86</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781092</data>
