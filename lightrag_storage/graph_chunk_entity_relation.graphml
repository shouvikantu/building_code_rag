      <data key="d0">Subdistricts A and B</data>
      <data key="d1">location</data>
      <data key="d2">Subdistricts A and B are designated areas under zoning regulations where specific bonus options and restrictions apply.</data>
      <data key="d3">chunk-7d36b64a92b4e219eb8b81cf9934efff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781104</data>
