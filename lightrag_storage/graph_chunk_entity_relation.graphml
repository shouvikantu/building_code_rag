    <node id="Standard 2">
      <data key="d0">Standard 2</data>
      <data key="d1">concept</data>
      <data key="d2">Standard 2 necessitates that 100 percent of the ground-level street-facing facade must adhere to the maximum setback requirement.</data>
      <data key="d3">chunk-c05d0565960f8c21b2582374b4856a38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781137</data>
