    <node id="Local Service Street">
      <data key="d0">Local Service Street</data>
      <data key="d1">concept</data>
      <data key="d2">Local Service Street pertains to a type of road that may influence height limits of adjacent structures according to zoning rules.&lt;SEP&gt;A local service street is classified according to the Transportation System Plan, catering primarily to local traffic needs.</data>
      <data key="d3">chunk-a966c4eaabe25aca0a1be25bd188299e&lt;SEP&gt;chunk-61e934d288b532969001ac5c602e3192</data>
      <data key="d4">unknown_source</data>
