    <node id="Nondiscretionary Review">
      <data key="d0">Nondiscretionary Review</data>
      <data key="d1">method</data>
      <data key="d2">Nondiscretionary Review is a type of administrative review that follows set procedures without allowing for exceptions based on the proposed land use.</data>
      <data key="d3">chunk-5a98088aa848c3a646425801c36c9f6b</data>
