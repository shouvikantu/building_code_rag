    <node id="Base Flood Level">
      <data key="d0">Base Flood Level</data>
      <data key="d1">concept</data>
      <data key="d2">The Base Flood Level is the minimum elevation for structures to avoid flood risks, as defined in the text.</data>
      <data key="d3">chunk-8ba12577414f8d5a3adb28727f2e0ff6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
      <data key="d6" />
    </node>
    <node id="Flood Damage">
      <data key="d0">Flood Damage</data>
      <data key="d1">concept</data>
      <data key="d2">Flood damage refers to the potential detrimental effects caused by flooding on life, property, and facilities as discussed in the regulations.</data>
      <data key="d3">chunk-8ba12577414f8d5a3adb28727f2e0ff6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
