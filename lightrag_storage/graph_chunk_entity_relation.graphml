    <node id="Multnomah Drainage District No. 1">
      <data key="d0">Multnomah Drainage District No. 1</data>
      <data key="d1">organization</data>
      <data key="d2">Multnomah Drainage District No. 1 is one of the entities responsible for managing flood zones and flood hazard areas.&lt;SEP&gt;Multnomah Drainage District No. 1 is a drainage district that is involved in flood management and protection strategies.&lt;SEP&gt;Multnomah Drainage District No. 1 is a regulatory body overseeing flood management including specific flood zones requiring compensatory volumes.</data>
      <data key="d3">chunk-cbba9ae1b324ef0410472174c02e9e9d&lt;SEP&gt;chunk-eaf6bc29b8214191b42a335cb7e2fc17&lt;SEP&gt;chunk-df3d014b174352ce9ad5757f1156a2b1</data>
