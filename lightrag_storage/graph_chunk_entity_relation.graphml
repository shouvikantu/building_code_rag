    <node id="Category Three">
      <data key="d0">Category Three</data>
      <data key="d1">category</data>
      <data key="d2">Category Three comprises all other vendors at farmers markets who are not related to agricultural or food products.&lt;SEP&gt;Category Three encompasses all other market vendors who are not required to be connected to agriculture or food.</data>
