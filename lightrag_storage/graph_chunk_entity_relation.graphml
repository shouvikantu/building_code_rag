    <node id="Accessary Uses">
      <data key="d0">Accessary Uses</data>
      <data key="d1">concept</data>
      <data key="d2">Accessory uses are supplementary activities that are permitted if identified in an institution's approved impact mitigation plan or conditional use master plan.</data>
