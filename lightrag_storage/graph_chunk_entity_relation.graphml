    <node id="Paving Standards">
      <data key="d0">Paving Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Paving Standards dictate the requirements for driveways and parking areas, primarily emphasizing the need for paved surfaces.</data>
      <data key="d3">chunk-16b2323b48f41f87137658c4c38c98ae</data>
