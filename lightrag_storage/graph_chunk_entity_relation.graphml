      <data key="d1">concept</data>
      <data key="d2">OAR 414-305-0000 through 414-305-1620 refers to a set of regulations governing child care providers and their operations.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781566</data>
      <data key="d6" />
