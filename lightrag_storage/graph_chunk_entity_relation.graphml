    <node id="Appellant">
      <data key="d0">Appellant</data>
      <data key="d1">person</data>
      <data key="d2">The appellant is the individual whose substantive rights are claimed to have been prejudiced by an error in procedure by the local government.</data>
      <data key="d3">chunk-14945c9dafbb0b5a4864c97b10515585</data>
