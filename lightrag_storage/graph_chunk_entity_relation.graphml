    <node id="Items Exempt From This Chapter">
      <data key="d0">Items Exempt From This Chapter</data>
      <data key="d1">concept</data>
      <data key="d2">Items Exempt From This Chapter refer to specific developments and improvements that do not require compliance with certain design standards or approvals.</data>
      <data key="d3">chunk-f92d57fd526433c19e4bdb08e2032fe0</data>
