    <node id="Technical Assistance">
      <data key="d0">Technical Assistance</data>
      <data key="d1">concept</data>
      <data key="d2">Technical Assistance involves providing guidance to child care providers to ensure regulatory compliance.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37</data>
      <data key="d4">unknown_source</data>
