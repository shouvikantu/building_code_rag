    <node id="Multi-Dwelling Zone Standards">
      <data key="d0">Multi-Dwelling Zone Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Multi-dwelling zone standards refer to specific regulations that apply to residential buildings containing multiple dwelling units.</data>
      <data key="d3">chunk-cbb810e875d66f848b351a4f1271e2a7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781095</data>
      <data key="d6" />
    </node>
    <node id="Setback Standards">
      <data key="d0">Setback Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Setback standards are regulations that determine the minimum distance buildings must be set back from property lines or streets.&lt;SEP&gt;Setback standards are regulations that dictate the distance buildings must be set back from property lines to ensure light, air, and privacy.</data>
      <data key="d3">chunk-cbb810e875d66f848b351a4f1271e2a7&lt;SEP&gt;chunk-b1c01837a01a91075eb01c907ccb32c8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781095</data>
      <data key="d6" />
    </node>
    <node id="RM1 – RMP Zones">
      <data key="d0">RM1 – RMP Zones</data>
      <data key="d1">location</data>
      <data key="d2">The RM1 – RMP Zones are areas where mass shelters serving victims of sexual or domestic violence are allowed by right.</data>
      <data key="d3">chunk-3caa6629bdef153dada4d72aed50d85b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781095</data>
      <data key="d6" />
    </node>
