      <data key="d0">Allowed Use</data>
      <data key="d1">concept</data>
      <data key="d2">Allowed use refers to the specific conditions under which new mass shelters or modifications to existing shelters can be legally conducted.</data>
      <data key="d3">chunk-3caa6629bdef153dada4d72aed50d85b</data>
