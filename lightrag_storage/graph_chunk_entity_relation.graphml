      <data key="d1">concept</data>
      <data key="d2">Major Transit Priority Streets are key streets prioritized for public transit to enhance accessibility and efficiency.</data>
      <data key="d3">chunk-bbc54ab4dbbc617d4c752a69733a5f32</data>
      <data key="d4">unknown_source</data>
