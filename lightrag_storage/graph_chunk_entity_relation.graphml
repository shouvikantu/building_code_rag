      <data key="d1">concept</data>
      <data key="d2">The Exterior Property Area encompasses the outdoor spaces surrounding a residence or building.</data>
      <data key="d3">chunk-44500823ae619d4a2c4e588251577618</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779854</data>
      <data key="d6" />
