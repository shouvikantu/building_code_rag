    <node id="Build-To Line Area">
      <data key="d0">Build-To Line Area</data>
      <data key="d1">concept</data>
      <data key="d2">The Build-To Line Area (BTLA) is a designated zone regulating building setbacks and frontages in urban development.</data>
      <data key="d3">chunk-6ceb5a192403b5b7a44ecca67568f01e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781000</data>
