    <node id="Caliper Inch">
      <data key="d0">Caliper Inch</data>
      <data key="d1">concept</data>
      <data key="d2">Caliper inch is a measurement method for assessing the diameter of a tree trunk, specifically measured 6 inches above the ground or root ball.</data>
      <data key="d3">chunk-a70e49b32e27402af67173acaf34a3c9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781078</data>
      <data key="d6" />
    </node>
    <node id="Root Protection Zone">
      <data key="d0">Root Protection Zone</data>
      <data key="d1">concept</data>
      <data key="d2">Root Protection Zone defines the area around a tree that must be preserved to maintain its health and stability during construction activities.&lt;SEP&gt;The root protection zone is defined as a circular area surrounding a tree based on its diameter, crucial for preserving tree health.</data>
      <data key="d3">chunk-a70e49b32e27402af67173acaf34a3c9&lt;SEP&gt;chunk-f65e5459208816c049f71f8dc6ffc84e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781078</data>
      <data key="d6" />
    </node>
    <node id="Perennial Streams">
      <data key="d0">Perennial Streams</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Perennial streams are watercourses that flow continuously throughout the year, important in ecological and hydrological contexts.</data>
      <data key="d3">chunk-a70e49b32e27402af67173acaf34a3c9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781079</data>
      <data key="d6" />
    </node>
    <node id="Intermittent Streams">
      <data key="d0">Intermittent Streams</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Intermittent streams are watercourses that do not flow continuously, often affected by seasonal changes and rainfall.</data>
      <data key="d3">chunk-a70e49b32e27402af67173acaf34a3c9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781079</data>
      <data key="d6" />
    </node>
    <node id="Ephemeral Streams">
      <data key="d0">Ephemeral Streams</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Ephemeral streams are watercourses that exist only during certain times, usually after rain, impacting local ecosystems.</data>
      <data key="d3">chunk-a70e49b32e27402af67173acaf34a3c9</data>
      <data key="d4">unknown_source</data>
