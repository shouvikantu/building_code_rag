    <node id="Historic Designation Review">
      <data key="d0">Historic Designation Review</data>
      <data key="d1">method</data>
      <data key="d2">Historic Designation Review evaluates the historic significance of resources being designated or reclassified within a Conservation District.&lt;SEP&gt;Historic Designation Review is a process that allows the City of Portland to recognize and protect historic landmarks and districts.</data>
      <data key="d3">chunk-d7bc900b38790ffcdef889113926820f&lt;SEP&gt;chunk-fca333850d886eb6696137e8d84c9908</data>
      <data key="d4">unknown_source</data>
