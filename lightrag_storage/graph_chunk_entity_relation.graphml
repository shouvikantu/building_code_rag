    <node id="Public Water Supply">
      <data key="d0">Public Water Supply</data>
      <data key="d1">data</data>
      <data key="d2">A public water supply is a source of drinking water that must be used by certified child care centers unless an approved alternative is utilized.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781563</data>
