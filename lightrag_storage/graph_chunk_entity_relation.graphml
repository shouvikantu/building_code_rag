    <node id="Building Height Standards">
      <data key="d0">Building Height Standards</data>
      <data key="d1">concept</data>
      <data key="d2">The building height standards specify maximum allowed heights for buildings in the North Interstate Plan District to enhance visual prominence and functionality.</data>
      <data key="d3">chunk-94342616311fab47b2c9483e52cd9046</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781125</data>
