    <node id="Transportation Management Association">
      <data key="d0">Transportation Management Association</data>
      <data key="d1">organization</data>
      <data key="d2">Transportation Management Association is an organization focused on improving transportation efficiency and management in urban areas.&lt;SEP&gt;A Transportation Management Association manages transportation or parking to reduce reliance on automobiles within local communities.</data>
      <data key="d3">chunk-5b7a46ce2a41072cf8f503e930128f86&lt;SEP&gt;chunk-94d2f2ba51a73a23de500a4e54b5f682</data>
