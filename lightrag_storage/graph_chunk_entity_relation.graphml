    <node id="Figure 266-4">
      <data key="d0">Figure 266-4</data>
      <data key="d1">artifact</data>
      <data key="d2">Figure 266-4 shows parking dimension factors relevant to parking area design.</data>
      <data key="d3">chunk-dc6b437da193232c09faa03338cb2957</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781097</data>
      <data key="d6" />
