    <node id="Spring">
      <data key="d0">Spring</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A Spring is a natural water source that may be found on a site and influences zoning and design considerations.&lt;SEP&gt;A spring is a natural source of water that emerges from the ground, which is considered alongside streams and wetlands regarding site delineation.</data>
      <data key="d3">chunk-04cb5d072ac6b2a3e906facf4052c5aa&lt;SEP&gt;chunk-6fe16dacd4c0cb29ef445c2340ee2812</data>
