      <data key="d0">Surrounding Neighborhoods</data>
      <data key="d1">location</data>
      <data key="d2">The Surrounding Neighborhoods refer to the areas adjacent to the site being developed under the PIR Master Plan.</data>
      <data key="d3">chunk-1cd2a226a2530256c685d499d90fe0b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781109</data>
