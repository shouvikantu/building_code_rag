    <node id="Federal Communications Commission">
      <data key="d0">Federal Communications Commission</data>
      <data key="d1">organization</data>
      <data key="d2">The Federal Communications Commission regulates interstate and international communications, establishing standards for radio frequency emissions levels and exposure limits.&lt;SEP&gt;The Federal Communications Commission is a regulatory agency that licenses Radio Frequency Transmission Facilities and oversees compliance.&lt;SEP&gt;The Federal Communications Commission (FCC) is the regulatory body that establishes standards for radio frequency emissions levels.</data>
      <data key="d3">chunk-1e0d3aa49a8c3edf6ae58238049a8d3b&lt;SEP&gt;chunk-f1ba8ca0ee507a65dfd09ccd9194cfe1&lt;SEP&gt;chunk-5e42a30908ffae3b0ae86fe413532d36</data>
