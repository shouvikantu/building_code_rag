      <data key="d0">East Pattern Area</data>
      <data key="d1">location</data>
      <data key="d2">The Eastern Pattern Area indicates a specific geographical section that requires certain landscaping standards as per zoning guidelines.</data>
      <data key="d3">chunk-b0081003d43e7b772e5a8d3dfae39548</data>
      <data key="d4">unknown_source</data>
