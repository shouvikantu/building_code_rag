    <node id="Bottles">
      <data key="d0">Bottles</data>
      <data key="d1">artifact</data>
      <data key="d2">Bottles are feeding containers used for infants, which should not be allowed during certain activities in a child care center.</data>
      <data key="d3">chunk-413de6970c782ab39f7b5ab84bc167b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781567</data>
      <data key="d6" />
    </node>
    <node id="CPSC Standards">
      <data key="d0">CPSC Standards</data>
      <data key="d1">concept</data>
      <data key="d2">CPSC standards are safety regulations established for products used in child care centers to ensure the safety of infants and toddlers.</data>
