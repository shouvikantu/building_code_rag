    <node id="Asbestos Survey">
      <data key="d0">Asbestos Survey</data>
      <data key="d1">document</data>
      <data key="d2">The asbestos survey is a required assessment to identify hazardous materials in structures considered for demolition.&lt;SEP&gt;An Asbestos Survey is a report that identifies the presence of asbestos in a structure as per legal requirements.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110&lt;SEP&gt;chunk-c5b35452c31cb9f158ca9f1bcfd06571</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
