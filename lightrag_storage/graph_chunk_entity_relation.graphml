    <node id="Surfacing Materials">
      <data key="d0">Surfacing Materials</data>
      <data key="d1">concept</data>
      <data key="d2">Surfacing materials include lawn, pavers, decking, and sport court paving used in required outdoor areas.</data>
      <data key="d3">chunk-6e474c16a2f491d5d3d21de73c32071c</data>
      <data key="d4">unknown_source</data>
