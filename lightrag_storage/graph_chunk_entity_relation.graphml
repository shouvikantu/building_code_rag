    <node id="January 2, 2032">
      <data key="d0">January 2, 2032</data>
      <data key="d1">date</data>
      <data key="d2">January 2, 2032 marks the date after which adjustments to minimum lot area requirements are prohibited.&lt;SEP&gt;January 2, 2032, is the deadline after which adjustments to various standards related to cottage clusters are prohibited.&lt;SEP&gt;January 2, 2032 marks the deadline by which certain building adjustments or modifications can be requested.&lt;SEP&gt;January 2, 2032, is the deadline by which requests for adjustments to increase bonus heights for new buildings must be made.&lt;SEP&gt;January 2, 2032 is a deadline by which adjustments to flag lot pole width may be requested.</data>
      <data key="d3">chunk-4e156b5dd560d7dd7cf18d1c12b0bb44&lt;SEP&gt;chunk-a1daea73587f156d45df1e0850a2216e&lt;SEP&gt;chunk-59644a82d0120b0f13d2a9d402862b9b&lt;SEP&gt;chunk-59fe4540439f409de13002eb40172d2d&lt;SEP&gt;chunk-38e8e418ed77b8672d2e0bbc7d7689df</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781071</data>
