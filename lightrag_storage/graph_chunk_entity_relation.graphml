    <node id="Public Notice">
      <data key="d0">Public Notice</data>
      <data key="d1">concept</data>
      <data key="d2">Public notice pertains to the requirement of informing the public about development applications on specific sites.&lt;SEP&gt;Public Notice is a communication that must be placed on the site signifying the ongoing design advice request process.</data>
      <data key="d3">chunk-28182b619a9a912d117b6795858e20f7&lt;SEP&gt;chunk-699f7379e9519e29f504f42bb94daaf0</data>
