      <data key="d1">concept</data>
      <data key="d2">External Doors are entry points of a building that are visible from the exterior, which have specific zoning restrictions regarding their presence in certain uses.</data>
      <data key="d3">chunk-cac21afda0123f450c6fc8b893e703d6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781116</data>
      <data key="d6" />
