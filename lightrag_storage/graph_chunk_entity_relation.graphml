    <node id="National Register">
      <data key="d0">National Register</data>
      <data key="d1">organization</data>
      <data key="d2">The National Register is referenced for its role in identifying historic significance and attributes related to resources.&lt;SEP&gt;The National Register is a program that recognizes historic properties worthy of preservation.</data>
      <data key="d3">chunk-3f72437166c353de768d234823279f24&lt;SEP&gt;chunk-059f078c9e0b5ea778bd163f9c511685</data>
