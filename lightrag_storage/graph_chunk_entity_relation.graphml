    <node id="33.130.212.C">
      <data key="d0">33.130.212.C</data>
      <data key="d1">data</data>
      <data key="d2">Section 33.130.212.C outlines the inclusionary housing standards that must be followed for proposals utilizing the inclusionary housing bonus.</data>
      <data key="d3">chunk-4e156b5dd560d7dd7cf18d1c12b0bb44</data>
      <data key="d4">unknown_source</data>
