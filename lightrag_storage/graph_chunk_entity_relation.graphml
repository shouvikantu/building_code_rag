      <data key="d6" />
    </node>
    <node id="Mitigation Bank Credits">
      <data key="d0">Mitigation Bank Credits</data>
      <data key="d1">concept</data>
      <data key="d2">Mitigation Bank Credits refer to credits that may be used as substitutes for compensatory excavation or removal of structures, contingent on approval by the City.&lt;SEP&gt;Mitigation bank credits are permits that allow for compensatory excavation or removal of permanent structures in flood-prone areas, contingent on approval by local authorities.&lt;SEP&gt;Mitigation Bank Credits are credits that can be purchased from a City-approved mitigation bank to meet certain regulatory requirements.&lt;SEP&gt;Mitigation bank credits refer to credits purchased from a city-approved bank to satisfy environmental requirements.</data>
      <data key="d3">chunk-b4860d0c2d23496924b4803e5942c793&lt;SEP&gt;chunk-25a47da3153ff3a91ef0d0af937548b1&lt;SEP&gt;chunk-6f2f9d38007eada5085a52ba7956a5b5&lt;SEP&gt;chunk-37c7c788c54dd25901bd6c8ddfb5d32d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781092</data>
      <data key="d6" />
    </node>
    <node id="PICM Regulations">
      <data key="d0">PICM Regulations</data>
      <data key="d1">concept</data>
      <data key="d2">PICM Regulations are compliance measures that aim to prohibit net loss in natural floodplain functions such as flood storage and water quality.</data>
      <data key="d3">chunk-b4860d0c2d23496924b4803e5942c793</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
    </node>
    <node id="Special Flood Hazard Area">
      <data key="d0">Special Flood Hazard Area</data>
      <data key="d1">location</data>
      <data key="d2">Special Flood Hazard Area designates regions where specific flood risk management measures must be applied, particularly regarding tree removal and replacement.&lt;SEP&gt;The Special Flood Hazard Area is a designated zone that is at high risk of flooding and requires specific regulatory compliance for development projects.&lt;SEP&gt;A special flood hazard area is land prone to floodwaters of a base flood, as designated by FEMA maps.&lt;SEP&gt;Special flood hazard area is the land area covered by floodwaters of the base flood, as indicated on FEMA maps.</data>
      <data key="d3">chunk-b4860d0c2d23496924b4803e5942c793&lt;SEP&gt;chunk-25a47da3153ff3a91ef0d0af937548b1&lt;SEP&gt;chunk-61e934d288b532969001ac5c602e3192&lt;SEP&gt;chunk-1ad3df252c10f7d3d9869375a3dd70b5</data>
