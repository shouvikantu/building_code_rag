    <node id="Golf Cart Paths">
      <data key="d0">Golf Cart Paths</data>
      <data key="d1">concept</data>
      <data key="d2">Golf cart paths are designated pathways for golf carts on golf courses that must adhere to specific design and environmental standards.</data>
      <data key="d3">chunk-539f4010f687efe24bc7e2b559aec360</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781003</data>
