    <node id="Unsafe or Hazardous Structures">
      <data key="d0">Unsafe or Hazardous Structures</data>
      <data key="d1">concept</data>
      <data key="d2">Unsafe or Hazardous Structures refer to buildings that pose a risk to human life and may qualify for exemption from standard demolition requirements.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779849</data>
      <data key="d6" />
    </node>
    <node id="City Requirements for Water Discharge">
      <data key="d0">City Requirements for Water Discharge</data>
      <data key="d1">regulation</data>
      <data key="d2">These requirements outline how stormwater and any collected water on the site must be managed and discharged.</data>
      <data key="d3">chunk-930e46297d467ccce29bccc576758110</data>
      <data key="d4">unknown_source</data>
