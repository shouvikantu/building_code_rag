    <node id="Microwave Facility">
      <data key="d0">Microwave Facility</data>
      <data key="d1">concept</data>
      <data key="d2">Microwave Facility is a component that may be included in the design of towers accommodating radio or television broadcast systems.</data>
      <data key="d3">chunk-1e0d3aa49a8c3edf6ae58238049a8d3b</data>
