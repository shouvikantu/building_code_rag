    </node>
    <node id="Outdoor Area Standards">
      <data key="d0">Outdoor Area Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Outdoor area standards dictate requirements for preserving landscaped outdoor spaces to qualify for bonus height adjustments.</data>
      <data key="d3">chunk-4e156b5dd560d7dd7cf18d1c12b0bb44</data>
