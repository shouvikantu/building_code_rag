    <node id="Figures 258-1">
      <data key="d0">Figures 258-1</data>
      <data key="d1">data</data>
      <data key="d2">Figures 258-1 illustrates the area of possible expansion within OS and R zones concerning nonconforming uses.</data>
      <data key="d3">chunk-c12d6555e1901995a51aaf68fcae440f</data>
