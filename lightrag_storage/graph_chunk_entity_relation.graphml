    </node>
    <node id="Variances">
      <data key="d0">Variances</data>
      <data key="d1">concept</data>
      <data key="d2">Variances are exceptions to regulations that are considered under specific criteria concerning flood hazards and construction.</data>
      <data key="d3">chunk-8ba12577414f8d5a3adb28727f2e0ff6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
      <data key="d6" />
    </node>
    <node id="Variance">
      <data key="d0">Variance</data>
      <data key="d1">concept</data>
      <data key="d2">Variance is a grant of relief from requirements that allows construction not otherwise permitted under the specified Chapter.</data>
      <data key="d3">chunk-cbba9ae1b324ef0410472174c02e9e9d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
      <data key="d6" />
    </node>
    <node id="Willamette River North Reach">
      <data key="d0">Willamette River North Reach</data>
      <data key="d1">location</data>
      <data key="d2">Willamette River North Reach refers to the part of the Willamette River Flood Zone north of the Fremont and Broadway Bridges.</data>
      <data key="d3">chunk-cbba9ae1b324ef0410472174c02e9e9d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
      <data key="d6" />
    </node>
    <node id="Flood Insurance Rate Maps (FIRMs)">
      <data key="d0">Flood Insurance Rate Maps (FIRMs)</data>
      <data key="d1">content</data>
      <data key="d2">FIRMs are official maps delineating areas of flood hazards and flood zone boundaries in the City of Portland, Oregon.</data>
      <data key="d3">chunk-cbba9ae1b324ef0410472174c02e9e9d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779850</data>
