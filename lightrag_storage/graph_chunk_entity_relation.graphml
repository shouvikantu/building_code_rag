    <node id="City Regulations">
      <data key="d0">City Regulations</data>
      <data key="d1">other</data>
      <data key="d2">City regulations that may apply to recreational fields used for organized sports, as outlined in Title 20, Parks and Recreation.&lt;SEP&gt;City Regulations refer to municipal rules that apply to various aspects of local governance, including environmental management and public works.</data>
      <data key="d3">chunk-555b254650c4e6bcde7e85291a2480b7&lt;SEP&gt;chunk-1226a7075ba7d150a3b769bb492b29a1</data>
