    <node id="Performance Bond">
      <data key="d0">Performance Bond</data>
      <data key="d1">concept</data>
      <data key="d2">A Performance Bond is a financial guarantee required to ensure compliance with regulations regarding construction and site use.&lt;SEP&gt;A Performance Bond is a type of performance guarantee that is payable to the City in cash or other forms to ensure compliance with conditions of land use approvals.</data>
      <data key="d3">chunk-cc1a993d28187168df19c579664230fc&lt;SEP&gt;chunk-77e32332dad5644a1592ba93791f21ff</data>
