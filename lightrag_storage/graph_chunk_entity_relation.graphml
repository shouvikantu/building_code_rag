    <node id="Homeowners' Association">
      <data key="d0">Homeowners' Association</data>
      <data key="d1">organization</data>
      <data key="d2">A Homeowners' Association is an organization comprised of homeowners within a community, responsible for managing common areas and enforcing community regulations.&lt;SEP&gt;A homeowners' association is an organization that manages common areas and enforcement of rules in residential neighborhoods.</data>
      <data key="d3">chunk-1dfee1abb6388294ddd10d180ea3f102&lt;SEP&gt;chunk-4c2325c884efc6a13f1b84583326ff8d</data>
