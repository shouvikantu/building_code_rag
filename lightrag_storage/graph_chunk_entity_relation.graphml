    </node>
    <node id="Rear Lot Line">
      <data key="d0">Rear Lot Line</data>
      <data key="d1">concept</data>
      <data key="d2">The rear lot line is the boundary opposite the front lot line in typical lot configurations.</data>
      <data key="d3">chunk-0ab589ad2a81c7f7964b172f2ba2949a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781126</data>
      <data key="d6" />
    </node>
    <node id="Side Lot Line">
      <data key="d0">Side Lot Line</data>
      <data key="d1">concept</data>
      <data key="d2">The side lot line is defined as any lot line that is not a front or rear lot line.</data>
      <data key="d3">chunk-0ab589ad2a81c7f7964b172f2ba2949a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781126</data>
