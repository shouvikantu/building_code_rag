      <data key="d0">Observed Noncompliance</data>
      <data key="d1">concept</data>
      <data key="d2">Observed Noncompliance refers to instances where noncompliance is identified by CCLD staff within facility records.</data>
      <data key="d3">chunk-deb527afbb4ed29de2c78fcaed8b968e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781439</data>
