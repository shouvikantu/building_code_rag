    <node id="Renewable Fuel">
      <data key="d0">Renewable Fuel</data>
      <data key="d1">concept</data>
      <data key="d2">Renewable Fuel refers to energy produced from renewable resources with minimal fossil fuel content.&lt;SEP&gt;Renewable fuels include biodiesel, biomethane, and clean hydrogen, produced from non-petroleum renewable resources, with less than 5 percent fossil fuel content.</data>
      <data key="d3">chunk-194988951f77d654ea0875ebdb6acdde&lt;SEP&gt;chunk-9cfe18720ad9b5bf5dadab610a40b064</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781080</data>
