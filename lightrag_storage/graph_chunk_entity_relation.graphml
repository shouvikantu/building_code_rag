    <node id="Community Service Overlay Zone">
      <data key="d0">Community Service Overlay Zone</data>
      <data key="d1">concept</data>
      <data key="d2">A Community Service Overlay Zone is a specific zoning designation that may influence the approval of conditional uses on certain sites.</data>
      <data key="d3">chunk-afe903e400770e09111a01b6ada75d31</data>
      <data key="d4">unknown_source</data>
