    <node id="Child Care Child">
      <data key="d0">Child Care Child</data>
      <data key="d1">concept</data>
      <data key="d2">A Child Care Child refers to any child aged six weeks to 13 years or a child with special needs under 18, under the care of a licensed or exempt child care facility.</data>
      <data key="d3">chunk-1b94684ed4ccca82345e4aa1b6f991ce</data>
