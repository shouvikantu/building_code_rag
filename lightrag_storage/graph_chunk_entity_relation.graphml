    <node id="Regulatory Effects">
      <data key="d0">Regulatory Effects</data>
      <data key="d1">concept</data>
      <data key="d2">Regulatory effects refer to the implications and legal considerations associated with the proposed levels of protection for property designations.</data>
      <data key="d3">chunk-059f078c9e0b5ea778bd163f9c511685</data>
