    <node id="Aircraft Landing Zone">
      <data key="d0">Aircraft Landing Zone</data>
      <data key="d1">concept</data>
      <data key="d2">The Aircraft Landing Zone is an overlay that ensures safe operating conditions for aircraft near Portland International Airport by restricting the height of structures and vegetation.</data>
      <data key="d3">chunk-eda537024724fbc12582034b555f1424</data>
