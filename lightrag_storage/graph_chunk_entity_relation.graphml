    <node id="Public Schools">
      <data key="d0">Public Schools</data>
      <data key="d1">concept</data>
      <data key="d2">Public Schools are educational institutions whose floor area does not count towards maximum FAR if operated by or for a public school district.&lt;SEP&gt;Public Schools are institutions that provide state mandated basic education at the primary, elementary, middle, junior high, or high school level.</data>
      <data key="d3">chunk-92e255ad4213c8ff69b61a260e064f3c&lt;SEP&gt;chunk-464a103ac291e4d5b8cfdd5b7c5b692f</data>
