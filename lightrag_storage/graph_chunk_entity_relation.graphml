    <node id="Historic and Conservation District">
      <data key="d0">Historic and Conservation District</data>
      <data key="d1">location</data>
      <data key="d2">Historic and Conservation Districts are designated areas that have specific regulations impacting building heights and development standards to preserve historical and environmental qualities.</data>
      <data key="d3">chunk-199bdfd5f31802f14bb3bd7efff3a92e</data>
