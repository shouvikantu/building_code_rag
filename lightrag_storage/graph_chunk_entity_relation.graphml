      <data key="d1">legislation</data>
      <data key="d2">House Bill 2916, enacted in 2019, affects the definitions regarding transitional housing accommodations in Oregon.</data>
      <data key="d3">chunk-616337655b3a110b38e3cef90183ec87</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768779851</data>
