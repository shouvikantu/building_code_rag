    <node id="Toddler">
      <data key="d0">Toddler</data>
      <data key="d1">concept</data>
      <data key="d2">Toddler is a child aged between 12 to 36 months, categorized further into Younger Toddler and Older Toddler.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781566</data>
      <data key="d6" />
    </node>
    <node id="Visitor">
      <data key="d0">Visitor</data>
      <data key="d1">concept</data>
      <data key="d2">Visitor refers to individuals present at a child care program for a specific, transient purpose, not counted as staff.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781566</data>
      <data key="d6" />
    </node>
    <node id="Volunteer">
      <data key="d0">Volunteer</data>
      <data key="d1">person</data>
      <data key="d2">Volunteer is a person who offers services to a child care center without compensation and has specific access restrictions.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781566</data>
      <data key="d6" />
    </node>
    <node id="OAR 414-305-0710">
      <data key="d0">OAR 414-305-0710</data>
      <data key="d1">concept</data>
      <data key="d2">OAR 414-305-0710 pertains to regulations regarding prohibited discipline and actions within child care centers.&lt;SEP&gt;OAR 414-305-0710 is an administrative rule that outlines prohibited disciplinary methods in child care settings.</data>
      <data key="d3">chunk-e9bfaa4fbd71dff40822ddf8883aba37&lt;SEP&gt;chunk-d327b69848990feffa0bdfcf7346e6b4</data>
