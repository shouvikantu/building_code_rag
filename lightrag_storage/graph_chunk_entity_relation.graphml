    <node id="Johnson Creek Basin Protection Plan">
      <data key="d0">Johnson Creek Basin Protection Plan</data>
      <data key="d1">event</data>
      <data key="d2">The Johnson Creek Basin Protection Plan is an environmental study report aimed at protecting resources within the Johnson Creek Basin.&lt;SEP&gt;The Johnson Creek Basin Protection Plan is a report designed to protect the Johnson Creek Basin's natural resources.</data>
      <data key="d3">chunk-835e0969f1f8d22f5d245f2db0653852&lt;SEP&gt;chunk-16b463643e19fbf1a7684090d0b63adb</data>
