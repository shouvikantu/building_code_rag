      <data key="d0">West Portland Multicultural Plan</data>
      <data key="d1">concept</data>
      <data key="d2">The West Portland Multicultural Plan outlines zoning regulations aimed at promoting community service and preserving affordable housing.</data>
      <data key="d3">chunk-7d36b64a92b4e219eb8b81cf9934efff</data>
