      <data key="d0">Floor Plan</data>
      <data key="d1">content</data>
      <data key="d2">A floor plan is a diagram submitted by certified child care centers identifying the locations of drinking water faucets or fixtures tested for safety.</data>
      <data key="d3">chunk-be090fdda697a58316cf9a10e3df9d86</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781563</data>
      <data key="d6" />
