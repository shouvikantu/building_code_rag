    <node id="Planting Support Measures">
      <data key="d0">Planting Support Measures</data>
      <data key="d1">method</data>
      <data key="d2">Planting support measures such as stakes and guy wires are used to stabilize plants during periods of extreme winds, but must be removed once the plants can support themselves.</data>
      <data key="d3">chunk-922c2152929ae106e2a8f4d1e7a324cf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781113</data>
