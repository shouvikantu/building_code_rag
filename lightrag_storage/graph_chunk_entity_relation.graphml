    <node id="Mailed Notice of Decision">
      <data key="d0">Mailed Notice of Decision</data>
      <data key="d1">concept</data>
      <data key="d2">The Mailed Notice of Decision refers to the formal communication sent to stakeholders regarding the review body's decision on land use actions.</data>
      <data key="d3">chunk-644cc4e15ec9d767b69917b94f282c47</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1768781125</data>
