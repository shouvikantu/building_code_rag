    <node id="Travel Trailers">
      <data key="d0">Travel Trailers</data>
      <data key="d1">artifact</data>
      <data key="d2">Travel trailers are another type of vehicle considered similar to manufactured homes, but excluded from specific insurance definitions.</data>
      <data key="d3">chunk-0822aa249af1cada3cc5aa958e97dce7</data>
      <data key="d4">unknown_source</data>
