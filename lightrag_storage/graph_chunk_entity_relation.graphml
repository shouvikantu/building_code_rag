    <node id="Family">
      <data key="d0">Family</data>
      <data key="d1">concept</data>
      <data key="d2">Family as defined in this context is a group related by blood, marriage, or adoption, or individuals living together with similar associations.&lt;SEP&gt;Family is defined as a group of individuals related by blood, marriage, or adoption, including functional relationships similar to those associations.</data>
      <data key="d3">chunk-1e4225b326e03d893cc33c6027465e12&lt;SEP&gt;chunk-210861f5af273887fc0b0ae0fd07edfd</data>
