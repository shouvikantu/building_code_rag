    <node id="Glare Standards">
      <data key="d0">Glare Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Glare Standards dictate permissible illumination levels to minimize light pollution and protect neighboring properties.</data>
      <data key="d3">chunk-d771f61eac49b01fc5796204c75025ef</data>
