    <node id="Child Care Licensing Division">
      <data key="d0">Child Care Licensing Division</data>
      <data key="d1">organization</data>
      <data key="d2">The Child Care Licensing Division is a branch within the Department of Early Learning and Care responsible for licensing child care facilities.</data>
      <data key="d3">chunk-1b94684ed4ccca82345e4aa1b6f991ce</data>
      <data key="d4">unknown_source</data>
